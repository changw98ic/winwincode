# syntax=docker/dockerfile:1.7
FROM rust:1.95.0-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends lld \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    RUSTFLAGS="-C link-arg=-fuse-ld=lld" \
    cargo build --release --locked --jobs 2 -p winwincode-server --bin winwincode-server \
      --no-default-features \
    && cp /src/target/release/winwincode-server /tmp/winwincode-server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --uid 10001 winwincode
COPY --from=build /tmp/winwincode-server /usr/local/bin/winwincode-server
RUN mkdir -p /var/lib/winwincode /var/lib/winwincode-secrets /workspace/repository \
    && chown -R winwincode:winwincode \
      /var/lib/winwincode \
      /var/lib/winwincode-secrets \
      /workspace/repository

USER winwincode
EXPOSE 8443
VOLUME ["/var/lib/winwincode"]
ENTRYPOINT ["/usr/local/bin/winwincode-server"]
