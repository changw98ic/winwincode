<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.winwincode.device-client</string>
  <key>ProgramArguments</key>
  <array>
    <string>__WWC_BINARY__</string>
    <string>device</string>
    <string>serve</string>
    <string>--data-dir</string>
    <string>__WWC_DATA_DIRECTORY__</string>
    <string>--server-url</string>
    <string>__WWC_SERVER_URL__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
