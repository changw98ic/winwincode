[Unit]
Description=WinWinCode Device Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/winwincode/device-client.env
ExecStart=__WWC_BINARY__ device serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
