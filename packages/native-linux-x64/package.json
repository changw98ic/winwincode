{
  "name": "@winwincode/native-linux-x64",
  "version": "0.0.0-dev.0",
  "description": "WinWinCode embedded Codex kernel binary for GNU Linux x64",
  "license": "Apache-2.0",
  "type": "module",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "exports": {
    "./build-info.json": "./prebuild/build-info.json",
    "./codex-linux-sandbox": "./prebuild/codex-linux-sandbox",
    "./winwincode-kernel-helper": "./prebuild/winwincode-kernel-helper",
    "./winwincode_native.node": "./prebuild/winwincode_native.node"
  },
  "files": [
    "prebuild"
  ],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./prebuild/codex-linux-sandbox",
      "./prebuild/winwincode-kernel-helper"
    ]
  },
  "winwincodeNativeTarget": "x86_64-unknown-linux-gnu"
}
