{
  "name": "@winwincode/native-darwin-arm64",
  "version": "0.1.0-alpha.1",
  "description": "WinWinCode embedded Codex kernel binary for Apple Silicon macOS",
  "license": "Apache-2.0",
  "type": "module",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "exports": {
    "./build-info.json": "./prebuild/build-info.json",
    "./winwincode-kernel-helper": "./prebuild/winwincode-kernel-helper",
    "./winwincode_native.node": "./prebuild/winwincode_native.node"
  },
  "files": [
    "prebuild"
  ],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "./prebuild/winwincode-kernel-helper"
    ]
  },
  "winwincodeNativeTarget": "aarch64-apple-darwin"
}
