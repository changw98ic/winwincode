{
  "name": "@winwincode/native",
  "version": "0.1.0-alpha.1",
  "description": "Platform selector and JavaScript boundary for the embedded WinWinCode kernel",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24 <25"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@winwincode/contracts": "workspace:*"
  },
  "optionalDependencies": {
    "@winwincode/native-darwin-arm64": "workspace:*",
    "@winwincode/native-darwin-x64": "workspace:*",
    "@winwincode/native-linux-arm64": "workspace:*",
    "@winwincode/native-linux-x64": "workspace:*"
  }
}
