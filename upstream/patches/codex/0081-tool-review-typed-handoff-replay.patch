+use crate::tools::registry::CoreToolRuntime;
+
+struct HandoffReadGate;
+
+impl crate::ToolCallGate for HandoffReadGate {
+    fn authorize(
+        &self,
+        _: crate::ToolCallGateRequest,
+    ) -> futures::future::BoxFuture<
+        'static,
+        Result<crate::ToolCallGateAuthorization, crate::ToolCallGateRejection>,
+    > {
+        Box::pin(async { Ok(crate::ToolCallGateAuthorization::default()) })
+    }
+
+    fn revalidate(
+        &self,
+        _: crate::ToolCallGateRequest,
+        _: crate::ToolCallGateAuthorization,
+    ) -> futures::future::BoxFuture<'static, Result<(), crate::ToolCallGateRejection>> {
+        Box::pin(async { Ok(()) })
+    }
+
+    fn authorize_result_read(
+        &self,
+        _: crate::ToolResultReadRequest,
+    ) -> futures::future::BoxFuture<
+        'static,
+        Result<crate::ToolCallGateAuthorization, crate::ToolCallGateRejection>,
+    > {
+        Box::pin(async { Ok(crate::ToolCallGateAuthorization::default()) })
+    }
+
+    fn revalidate_result_read(
+        &self,
+        _: crate::ToolResultReadRequest,
+        _: crate::ToolCallGateAuthorization,
+    ) -> futures::future::BoxFuture<'static, Result<(), crate::ToolCallGateRejection>> {
+        Box::pin(async { Ok(()) })
+    }
+}
+
+struct DiagnosticHandoffTool {
+    effects: std::sync::atomic::AtomicUsize,
+    accepted: std::sync::atomic::AtomicUsize,
+}
+
+impl crate::tools::registry::ToolExecutor<crate::tools::context::ToolInvocation>
+    for DiagnosticHandoffTool
+{
+    fn tool_name(&self) -> codex_tools::ToolName {
+        crate::tools::handlers::SubmitChangeBatchHandler.tool_name()
+    }
+
+    fn spec(&self) -> codex_tools::ToolSpec {
+        crate::tools::handlers::SubmitChangeBatchHandler.spec()
+    }
+
+    fn handle(
+        &self,
+        invocation: crate::tools::context::ToolInvocation,
+    ) -> codex_tools::ToolExecutorFuture<'_> {
+        Box::pin(async move {
+            self.handle_core(invocation)
+                .await
+                .map(|result| result.output)
+        })
+    }
+}
+
+impl crate::tools::registry::CoreToolRuntime for DiagnosticHandoffTool {
+    fn authorization_policy(&self) -> crate::tools::authorization::AuthorizationPolicy {
+        crate::tools::authorization::AuthorizationPolicy::CoreControl
+    }
+
+    fn matches_kind(&self, payload: &crate::tools::context::ToolPayload) -> bool {
+        matches!(payload, crate::tools::context::ToolPayload::Custom { .. })
+    }
+
+    fn supports_result_replay(&self) -> bool {
+        // Exercise the stricter stored-continuation check even if an adapter
+        // opts into historical replay. The production submit handler does not.
+        true
+    }
+
+    fn handle_core(
+        &self,
+        invocation: crate::tools::context::ToolInvocation,
+    ) -> futures::future::BoxFuture<
+        '_,
+        Result<crate::tools::registry::CoreToolOutput, crate::function_tool::FunctionCallError>,
+    > {
+        use crate::tools::execution_facts::ExecutionFacts;
+        use crate::tools::execution_facts::nested_identity;
+        use crate::tools::execution_facts::storage_error;
+        Box::pin(async move {
+            let facts = ExecutionFacts::for_session(&invocation.session);
+            let store = facts.store.get().expect("registry initialized State");
+            let crate::tools::context::ToolCallSource::CodeMode {
+                cell_id,
+                runtime_tool_call_id,
+            } = &invocation.source
+            else {
+                panic!("registered Code Mode source");
+            };
+            let (_, scope) = facts.parent(cell_id).expect("registered owner");
+            let logical = nested_identity(cell_id, runtime_tool_call_id, &scope);
+            let boundary = store
+                .tool_request_fact(&invocation.session.thread_id.to_string(), &logical)
+                .await
+                .map_err(storage_error)?
+                .expect("running handoff request");
+            let diagnostic = codex_state::ToolDiagnostic {
+                schema_version: 1,
+                diagnostic_id: "handoff-offer-diagnosis".into(),
+                thread_id: invocation.session.thread_id.to_string(),
+                kind: codex_state::ToolDiagnosticKind::RepeatedOperation,
+                evidence_version: boundary.request_sequence,
+                progress_source_sequence: None,
+                evidence: vec![codex_state::ToolDiagnosticCall {
+                    request_sequence: boundary.request_sequence,
+                    logical_id: logical.clone(),
+                    tool_name: invocation.tool_name.to_string(),
+                    operation_digest: boundary.attempt.as_ref().unwrap().operation_digest.clone(),
+                    parent_call_id: boundary.request.parent_call_id.clone(),
+                    cell_id: boundary.request.cell_id.clone(),
+                }],
+                question: "What can advance the task?".into(),
+            };
+            store
+                .enqueue_tool_diagnostic(&diagnostic)
+                .await
+                .map_err(storage_error)?;
+            assert_eq!(
+                store
+                    .stage_tool_diagnostic_feedback(&diagnostic.thread_id, &logical)
+                    .await
+                    .map_err(storage_error)?,
+                vec![diagnostic]
+            );
+            self.effects
+                .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            crate::tools::handlers::SubmitChangeBatchHandler
+                .handle_core(invocation)
+                .await
+        })
+    }
+
+    fn on_tool_result_accepted(
+        &self,
+        _: &crate::tools::context::ToolInvocation,
+        _: &dyn codex_tools::ToolOutput,
+    ) {
+        self.accepted
+            .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+    }
+}
+
+fn latched_handoff(handoffs: &TerminalHandoffs, cell: &CellId) -> ChangeBatchHandoff {
+    let cells = handoffs.cells.lock().unwrap();
+    let Some(ToolContinuation::YieldToHost(handoff)) = cells.get(cell).unwrap().borrow().clone()
+    else {
+        panic!("original typed handoff must remain latched");
+    };
+    handoff
+}
