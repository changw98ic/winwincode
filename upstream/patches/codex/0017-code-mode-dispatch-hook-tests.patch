+#[tokio::test]
+async fn image_reads_revalidate_the_resolved_path_before_filesystem_access() {
+    let (session, turn) = crate::session::tests::make_session_and_context().await;
+    let records = Arc::new(Mutex::new(Vec::new()));
+    session
+        .services
+        .thread_extension_data
+        .insert(crate::ToolCallGateAttachment::new(Arc::new(
+            RecordingGate {
+                requests: Arc::clone(&records),
+                reject_revalidation: true,
+            },
+        )));
+    let turn = Arc::new(turn);
+    let result = crate::tools::handlers::ViewImageHandler::default()
+        .handle(ToolInvocation {
+            session: Arc::new(session),
+            step_context: crate::session::step_context::StepContext::for_test(Arc::clone(&turn)),
+            turn,
+            cancellation_token: tokio_util::sync::CancellationToken::new(),
+            tracker: Arc::new(tokio::sync::Mutex::new(
+                crate::turn_diff_tracker::TurnDiffTracker::new(),
+            )),
+            call_id: "image-read".into(),
+            tool_name: ToolName::plain("view_image"),
+            source: ToolCallSource::CodeMode {
+                cell_id: "cell-1".into(),
+                runtime_tool_call_id: "read-1".into(),
+            },
+            payload: ToolPayload::Function {
+                arguments: json!({"path":"missing-gated-image.png"}).to_string(),
+            },
+        })
+        .await;
+    assert!(
+        matches!(result, Err(crate::function_tool::FunctionCallError::RespondToModel(message)) if message.contains("PERMISSION_CHANGED"))
+    );
+    let records = records.lock().unwrap();
+    assert_eq!(records.len(), 2);
+    assert_eq!(records[0], records[1]);
+    assert!(
+        matches!(&records[0].payload, crate::ToolCallGatePayload::FileRead { path } if std::path::Path::new(path).is_absolute() && path.ends_with("missing-gated-image.png"))
+    );
+}
