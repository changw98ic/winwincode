+#[tokio::test]
+async fn post_hook_rejection_keeps_the_terminal_handoff_uncommitted() {
+    let (session, mut turn) = crate::session::tests::make_session_and_context().await;
+    turn.submit_change_batch = true;
+    install_trusted_hooks(
+        &session,
+        &mut turn,
+        json!({"hooks":{"PostToolUse":[{
+            "matcher":"submit_change_batch", "hooks":[{
+                "type":"command", "command":"printf '%s\\n' '{\"decision\":\"block\",\"reason\":\"proposal rejected\"}'",
+            }],
+        }]}}),
+    );
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    let registry =
+        ToolRegistry::from_tools([
+            Arc::new(crate::tools::handlers::SubmitChangeBatchHandler) as Arc<dyn CoreToolRuntime>
+        ]);
+    let result = registry
+        .dispatch_any_with_terminal_outcome(
+            ToolInvocation {
+                step_context: crate::session::step_context::StepContext::for_test(Arc::clone(
+                    &turn,
+                )),
+                session: Arc::clone(&session),
+                turn,
+                cancellation_token: tokio_util::sync::CancellationToken::new(),
+                tracker: Arc::new(tokio::sync::Mutex::new(
+                    crate::turn_diff_tracker::TurnDiffTracker::new(),
+                )),
+                call_id: "proposal-1".to_string(),
+                tool_name: ToolName::plain("submit_change_batch").with_default_namespace(),
+                source: ToolCallSource::CodeMode {
+                    cell_id: "cell-1".to_string(),
+                    runtime_tool_call_id: "runtime-1".to_string(),
+                },
+                payload: ToolPayload::Custom {
+                    input: "fixture proposal".to_string(),
+                },
+            },
+            None,
+        )
+        .await;
+    assert!(
+        matches!(result, Err(crate::function_tool::FunctionCallError::RespondToModel(message)) if message.contains("proposal rejected"))
+    );
+    assert!(
+        !session
+            .services
+            .code_mode_service
+            .terminal_handoffs
+            .is_pending(&codex_code_mode::CellId::new("cell-1".to_string()))
+    );
+}
