+pub(super) async fn has_trusted_recovery_policy(
+    replay: &super::execution_facts::ToolFactReplay,
+    tool: &dyn CoreToolRuntime,
+) -> Result<bool, FunctionCallError> {
+    if !matches!(
+        tool.authorization_policy(),
+        super::authorization::AuthorizationPolicy::HostOperation
+    ) {
+        return Ok(false);
+    }
+    Ok(replay
+        .store
+        .verified_tool_input_binding(replay.fact.request_sequence)
+        .await
+        .map_err(storage_error)?
+        .is_some_and(|binding| {
+            binding.snapshot.reuse == crate::ToolReusePermission::ImmutableValue
+        }))
+}
