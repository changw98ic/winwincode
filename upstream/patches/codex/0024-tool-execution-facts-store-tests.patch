+#[tokio::test]
+async fn unknown_effects_cannot_be_accepted_or_reexecuted() {
+    let (runtime, request) = setup().await;
+    let fact = observe(&runtime, &request).await;
+    runtime
+        .claim_tool_attempt(fact.request_sequence, "attempt", "owner", "effective", "{}")
+        .await
+        .unwrap();
+    runtime
+        .complete_tool_attempt(
+            fact.request_sequence,
+            "attempt",
+            "owner",
+            ToolExecutionStatus::Uncertain,
+            None,
+        )
+        .await
+        .unwrap();
+    assert!(
+        runtime
+            .decide_tool_output(
+                fact.request_sequence,
+                "attempt",
+                "owner",
+                ToolOutputDisposition::Accepted,
+                Some("unverified")
+            )
+            .await
+            .is_err()
+    );
+    assert!(matches!(
+        runtime
+            .claim_tool_attempt(fact.request_sequence, "new", "owner", "effective", "{}")
+            .await
+            .unwrap(),
+        ToolAttemptClaim::Existing(_)
+    ));
+}
