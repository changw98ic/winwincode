+#[tokio::test]
+async fn successful_execution_survives_hook_rejection_and_result_cleanup() {
+    let (runtime, request) = setup().await;
+    let fact = observe(&runtime, &request).await;
+    runtime
+        .claim_tool_attempt(fact.request_sequence, "attempt", "owner", "effective", "{}")
+        .await
+        .unwrap();
+    runtime
+        .complete_tool_attempt(
+            fact.request_sequence,
+            "attempt",
+            "owner",
+            ToolExecutionStatus::Completed,
+            Some("private-result"),
+        )
+        .await
+        .unwrap();
+    runtime
+        .decide_tool_output(
+            fact.request_sequence,
+            "attempt",
+            "owner",
+            ToolOutputDisposition::Rejected,
+            Some("hook blocked"),
+        )
+        .await
+        .unwrap();
+    let events = runtime
+        .list_tool_fact_events(&request.thread_id, 0, 200)
+        .await
+        .unwrap();
+    let receipt = events.last().unwrap().fact.attempt.as_ref().unwrap();
+    assert_eq!(
+        (receipt.execution, receipt.disposition, receipt.delivery),
+        (
+            ToolExecutionStatus::Completed,
+            ToolOutputDisposition::Rejected,
+            ToolOutputDelivery::Pending
+        )
+    );
+    assert!(
+        !serde_json::to_string(&events.last().unwrap().fact)
+            .unwrap()
+            .contains("private-result")
+    );
+    assert!(
+        runtime
+            .offer_tool_output(fact.request_sequence, "attempt", "owner")
+            .await
+            .is_err()
+    );
+    let results = runtime
+        .read_tool_results(fact.request_sequence)
+        .await
+        .unwrap();
+    assert_eq!(
+        (results.execution, results.accepted, results.rejection),
+        (
+            Some("private-result".into()),
+            None,
+            Some("hook blocked".into())
+        )
+    );
+    runtime
+        .forget_tool_results(fact.request_sequence)
+        .await
+        .unwrap();
+    let ToolRequestObservation::Replay(recovered) =
+        runtime.observe_tool_request(&request).await.unwrap()
+    else {
+        panic!("receipt")
+    };
+    let after = recovered.attempt.unwrap();
+    assert_eq!(
+        (
+            after.execution,
+            after.disposition,
+            after.execution_result_retained
+        ),
+        (
+            ToolExecutionStatus::Completed,
+            ToolOutputDisposition::Rejected,
+            false
+        )
+    );
+}
