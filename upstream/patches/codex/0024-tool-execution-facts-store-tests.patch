+use super::*;
+use crate::runtime::test_support::unique_temp_dir;
+use codex_protocol::ThreadId;
+use codex_utils_absolute_path::test_support::PathExt;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+async fn setup() -> (Arc<StateRuntime>, ToolRequestIdentity) {
+    let home = unique_temp_dir();
+    let runtime = StateRuntime::init(
+        crate::SqliteConfig::new_for_testing(home.as_path().abs()),
+        "test".into(),
+    )
+    .await
+    .unwrap();
+    let request = ToolRequestIdentity {
+        thread_id: ThreadId::new().to_string(),
+        logical_id: "call-1".into(),
+        turn_id: "turn-1".into(),
+        scope_id: "origin-scope".into(),
+        cell_id: Some("cell-1".into()),
+        parent_call_id: Some("exec-1".into()),
+        tool_name: "functions.shell".into(),
+        source: "code_mode".into(),
+        binding: "original-input-digest".into(),
+    };
+    (runtime, request)
+}
+
+async fn observe(runtime: &StateRuntime, request: &ToolRequestIdentity) -> ToolExecutionFact {
+    let ToolRequestObservation::New(fact) = runtime.observe_tool_request(request).await.unwrap()
+    else {
+        panic!("new observation")
+    };
+    fact
+}
+
+#[tokio::test]
+async fn competing_connections_claim_once_and_transport_replay_does_not_add_observations() {
+    let (runtime, request) = setup().await;
+    let other = StateRuntime::init(runtime.sqlite().clone(), "other".into())
+        .await
+        .unwrap();
+    let (a, b) = tokio::join!(
+        runtime.observe_tool_request(&request),
+        other.observe_tool_request(&request)
+    );
+    let (a, b) = (a.unwrap(), b.unwrap());
+    let fact = match (a, b) {
+        (ToolRequestObservation::New(fact), ToolRequestObservation::Replay(replayed))
+        | (ToolRequestObservation::Replay(replayed), ToolRequestObservation::New(fact)) => {
+            assert_eq!(fact, replayed);
+            fact
+        }
+        result => panic!("unexpected observations: {result:?}"),
+    };
+    let (a, b) = tokio::join!(
+        runtime.claim_tool_attempt(
+            fact.request_sequence,
+            "attempt-a",
+            "owner-a",
+            "effective",
+            "{}"
+        ),
+        other.claim_tool_attempt(
+            fact.request_sequence,
+            "attempt-b",
+            "owner-b",
+            "effective",
+            "{}"
+        )
+    );
+    let receipts = [a.unwrap(), b.unwrap()];
+    assert_eq!(
+        receipts
+            .iter()
+            .filter(|r| matches!(r, ToolAttemptClaim::Claimed(_)))
+            .count(),
+        1
+    );
+    assert_eq!(
+        runtime
+            .list_tool_fact_events(&request.thread_id, 0, 200)
+            .await
+            .unwrap()
+            .len(),
+        2
+    );
+    let mut new_request = request.clone();
+    new_request.logical_id = "call-2".into();
+    observe(&runtime, &new_request).await;
+    assert_eq!(
+        runtime
+            .list_tool_fact_events(&request.thread_id, 0, 200)
+            .await
+            .unwrap()
+            .len(),
+        3
+    );
+}
+
+#[tokio::test]
+async fn same_id_with_changed_input_or_parent_is_a_conflict() {
+    let (runtime, request) = setup().await;
+    observe(&runtime, &request).await;
+    for changed in [
+        ToolRequestIdentity {
+            binding: "different".into(),
+            ..request.clone()
+        },
+        ToolRequestIdentity {
+            parent_call_id: Some("other-parent".into()),
+            ..request.clone()
+        },
+    ] {
+        assert_eq!(
+            runtime.observe_tool_request(&changed).await.unwrap(),
+            ToolRequestObservation::IdentityConflict
+        );
+    }
+    assert_eq!(
+        runtime
+            .list_tool_fact_events(&request.thread_id, 0, 200)
+            .await
+            .unwrap()
+            .len(),
+        1
+    );
+}
