+#[tokio::test]
+async fn result_commit_and_output_offer_have_distinct_recovery_states() {
+    let (runtime, request) = setup().await;
+    let fact = observe(&runtime, &request).await;
+    runtime
+        .claim_tool_attempt(fact.request_sequence, "attempt", "owner", "effective", "{}")
+        .await
+        .unwrap();
+    runtime
+        .complete_tool_attempt(
+            fact.request_sequence,
+            "attempt",
+            "owner",
+            ToolExecutionStatus::Completed,
+            Some("raw"),
+        )
+        .await
+        .unwrap();
+    runtime
+        .decide_tool_output(
+            fact.request_sequence,
+            "attempt",
+            "owner",
+            ToolOutputDisposition::Accepted,
+            Some("accepted"),
+        )
+        .await
+        .unwrap();
+    let before = runtime
+        .list_tool_fact_events(&request.thread_id, 0, 200)
+        .await
+        .unwrap();
+    assert_eq!(
+        before
+            .last()
+            .unwrap()
+            .fact
+            .attempt
+            .as_ref()
+            .unwrap()
+            .delivery,
+        ToolOutputDelivery::Pending
+    );
+    runtime
+        .offer_tool_output(fact.request_sequence, "attempt", "owner")
+        .await
+        .unwrap();
+    runtime
+        .offer_tool_output(fact.request_sequence, "attempt", "owner")
+        .await
+        .unwrap();
+    let after = runtime
+        .list_tool_fact_events(&request.thread_id, before.last().unwrap().sequence, 1)
+        .await
+        .unwrap();
+    assert_eq!(after.len(), 1);
+    assert_eq!(
+        after[0].fact.attempt.as_ref().unwrap().delivery,
+        ToolOutputDelivery::Offered
+    );
+    let results = runtime
+        .read_tool_results(fact.request_sequence)
+        .await
+        .unwrap();
+    assert_eq!(
+        (results.execution, results.accepted),
+        (Some("raw".into()), Some("accepted".into()))
+    );
+}
