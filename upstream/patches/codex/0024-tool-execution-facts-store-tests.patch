+#[tokio::test]
+async fn restart_after_claim_never_grants_a_second_dispatch() {
+    let (runtime, request) = setup().await;
+    let fact = observe(&runtime, &request).await;
+    let claim = runtime
+        .claim_tool_attempt(
+            fact.request_sequence,
+            "attempt",
+            "old-owner",
+            "effective",
+            "{}",
+        )
+        .await
+        .unwrap();
+    let ToolAttemptClaim::Claimed(claimed) = claim else {
+        panic!("claim")
+    };
+    let reopened = StateRuntime::init(runtime.sqlite().clone(), "new".into())
+        .await
+        .unwrap();
+    assert_eq!(
+        reopened
+            .claim_tool_attempt(
+                fact.request_sequence,
+                "second-attempt",
+                "new-owner",
+                "effective",
+                "{}"
+            )
+            .await
+            .unwrap(),
+        ToolAttemptClaim::Existing(claimed)
+    );
+    assert!(
+        reopened
+            .complete_tool_attempt(
+                fact.request_sequence,
+                "attempt",
+                "new-owner",
+                ToolExecutionStatus::Completed,
+                Some("forged")
+            )
+            .await
+            .is_err()
+    );
+}
