+                .block_on(starts_resolved_agent_prompt_in_forked_thread_async())
+        })
+        .expect("agent service test thread should spawn");
+
+    match handle.join() {
+        Ok(result) => result,
+        Err(payload) => std::panic::resume_unwind(payload),
+    }
+}
