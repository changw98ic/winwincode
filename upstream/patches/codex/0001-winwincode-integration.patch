+                    body: codex_protocol::models::FunctionCallOutputBody::Text(id.to_string()),
+                    success: Some(success),
+                },
+                internal_chat_message_metadata_passthrough: None,
+            }),
+        ]
+    }
+
+    #[test]
+    fn deterministic_gc_keeps_latest_lifecycles_and_referenced_evidence_in_order() {
+        for (name, arguments, expected) in [
+            (
+                "exec_command",
