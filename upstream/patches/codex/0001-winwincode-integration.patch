+            ),
+            (
+                "apply_patch",
+                serde_json::json!({}),
+                ToolResultKind::FileWrite,
+            ),
+            (
+                "grep",
+                serde_json::json!({"pattern":"a"}),
+                ToolResultKind::Grep,
+            ),
+            (
+                "search",
+                serde_json::json!({"query":"a"}),
+                ToolResultKind::Search,
+            ),
+            (
+                "exec_command",
+                serde_json::json!({"cmd":"cargo test"}),
+                ToolResultKind::Test,
+            ),
+            (
+                "exec_command",
+                serde_json::json!({"cmd":"cargo build"}),
+                ToolResultKind::Build,
+            ),
+            (
+                "exec_command",
+                serde_json::json!({"cmd":"cargo clippy"}),
+                ToolResultKind::Lint,
+            ),
+            (
+                "exec_command",
