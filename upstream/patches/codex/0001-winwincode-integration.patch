+    pub token_usage: Option<TokenUsageInfo>,
+    pub started_at: Option<i64>,
+    pub completed_at: Option<i64>,
+    pub duration_ms: Option<i64>,
+    pub time_to_first_token_ms: Option<i64>,
+}
+
+impl std::fmt::Debug for DurableTurnTerminal {
