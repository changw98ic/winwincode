+#[cfg(test)]
+mod deterministic_argument_order_tests {
+    use super::*;
+
+    #[test]
+    fn key_value_arguments_are_sorted_before_macro_generation() {
+        let parsed = syn::parse_str::<FlArgs>(", right = 1, left = 2, middle = 3")
+            .expect("valid key-value arguments");
+        let FlArgs::KeyValuePairs { specified_args } = parsed else {
+            panic!("key-value arguments must use the key-value representation");
+        };
+        let ordered_keys: Vec<_> = specified_args
+            .iter()
+            .map(|(key, _value)| key.value())
+            .collect();
+
+        assert_eq!(ordered_keys, ["left", "middle", "right"]);
+    }
+
+    #[test]
+    fn duplicate_key_value_arguments_remain_rejected() {
+        let error = syn::parse_str::<FlArgs>(", left = 1, left = 2")
+            .expect_err("duplicate arguments must be rejected");
+
+        assert!(error.to_string().contains("duplicate argument `left`"));
+    }
+}
