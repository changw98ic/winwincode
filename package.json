{
  "name": "@winwincode/workspace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "WinWinCode workspace with an embedded Codex kernel and DeepSeek Harness surfaces",
  "repository": "https://github.com/changw98ic/winwincode",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "clean": "node scripts/clean.mjs",
    "format:check": "node scripts/check-format.mjs && cargo fmt --package winwincode-kernel-helper --package winwincode-kernel --package winwincode-native -- --check",
    "lint:source": "node scripts/lint-workspace.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "lint": "pnpm lint:source && pnpm typecheck && pnpm lint:rust",
    "typecheck": "tsc -p tsconfig.check.json --pretty false",
    "build:ts": "tsc -b tsconfig.json --pretty false && pnpm --filter @winwincode/strongflow bundle",
    "build:native": "node scripts/build-native.mjs",
    "build": "pnpm build:ts && pnpm build:native",
    "start": "node apps/host/dist/cli.js",
    "version:set": "node scripts/set-product-version.mjs",
    "fixture:delivery": "node scripts/run-keyless-delivery-fixture.mjs",
    "evaluate:live": "node scripts/run-live-evaluation.mjs",
    "measure:evaluation": "node scripts/run-evaluation-measures.mjs",
    "verify:release-native": "node scripts/run-native-release-gate.mjs",
    "verify:release": "node scripts/run-product-release-gate.mjs",
    "test:ts": "pnpm build:ts && pnpm build:native && node scripts/run-ts-tests.mjs",
    "test:rust": "cargo test --workspace --locked",
    "test": "pnpm test:ts && pnpm test:rust",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "verify:native-package": "node scripts/verify-native-package.mjs",
    "verify:native-install": "node scripts/verify-native-install.mjs",
    "verify:installed-host": "node scripts/verify-installed-host.mjs",
    "verify:packages": "pnpm build:ts && pnpm build:native && node scripts/verify-packages.mjs && pnpm verify:native-install && pnpm verify:installed-host",
    "verify:cpb-boundary": "node scripts/verify-cpb-boundary.mjs",
    "verify:fixture-cleanup": "node scripts/verify-runtime-cleanup.mjs",
    "verify:migration-baseline": "pnpm build:ts && pnpm build:native && node scripts/run-dsh-migration-baseline.mjs",
    "verify:upstream": "node scripts/verify-upstream-lock.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm verify:cpb-boundary && pnpm test && pnpm verify:fixture-cleanup && pnpm build && pnpm verify:packages && pnpm verify:upstream && pnpm verify:clean-install"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.8",
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.8",
    "@deepseek-ai/dsh-launch-environment": "catalog:",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm-pi-ai": "catalog:",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.8",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "catalog:",
    "@types/node": "24.13.3",
    "@types/react": "catalog:",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
