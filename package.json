{
  "name": "@winwincode/workspace",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "WinWinCode Client, Server, Worker, Local composition, and embedded Codex kernel",
  "repository": "https://github.com/changw98ic/winwincode",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preinstall": "node scripts/check/check-runtime.mjs",
    "clean": "node scripts/build/clean.mjs",
    "format:check": "node scripts/check/check-format.mjs && cargo fmt --all -- --check",
    "contracts:generate": "node scripts/build/generate-network-policy.mjs && node scripts/build/generate-contracts.mjs",
    "contracts:check": "node scripts/build/generate-network-policy.mjs --check && node scripts/build/generate-contracts.mjs --check",
    "lint:source": "node scripts/check/lint-workspace.mjs && node scripts/check/check-network-entrypoints.mjs",
    "check:no-absolute-paths": "node scripts/check/check-no-absolute-paths.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "lint": "pnpm lint:source && pnpm typecheck && pnpm lint:rust",
    "typecheck": "pnpm contracts:check && tsc -p tsconfig.check.json --pretty false",
    "build:ts": "pnpm contracts:check && tsc -b tsconfig.json --pretty false && pnpm --filter @winwincode/client build",
    "build:rust": "node scripts/build/build-community.mjs",
    "build": "pnpm build:ts && pnpm build:rust",
    "start": "cargo run -p winwincode-server --bin winwincode-server --locked",
    "version:set": "node scripts/release/set-product-version.mjs",
    "release:artifact": "node scripts/release/run-release-artifact-gate.mjs",
    "release:core-finalize": "node scripts/release/finalize-community-core-release.mjs",
    "release:core-worker": "node scripts/release/stage-community-core-worker-runtime.mjs",
    "verify:release-artifacts": "node scripts/release/verify-release-artifacts.mjs",
    "verify:release-artifact-security": "node scripts/release/verify-release-artifact-security.mjs",
    "verify:api-production-vertical": "node scripts/acceptance/run-api-production-vertical.mjs --device-prerequisites",
    "verify:api-production-sessions": "WWC_API_SKIP_BUILD=1 node --test --test-concurrency=1 tests/api-production-vertical.test.mjs",
    "verify:core-lock": "node scripts/release/verify-core-lock.mjs --lock",
    "test:ts": "pnpm build:ts && node scripts/acceptance/run-ts-tests.mjs",
    "test:rust": "cargo build -p winwincode-kernel-helper --bin winwincode-kernel-helper --locked && cargo test --workspace --all-features --locked",
    "test": "pnpm test:ts && pnpm test:rust",
    "test:rust:built": "cargo test --workspace --all-features --locked",
    "verify:products": "node scripts/check/verify-products.mjs",
    "verify:source": "pnpm format:check && pnpm lint:source",
    "verify:typescript": "pnpm test:ts && node scripts/check/verify-products.mjs --scope typescript",
    "verify:rust": "pnpm build:rust && pnpm lint:rust && pnpm test:rust:built && node scripts/check/verify-products.mjs --scope rust && pnpm verify:api-production-vertical && pnpm verify:api-production-sessions",
    "verify": "pnpm verify:source && pnpm verify:typescript && pnpm verify:rust",
    "verify:codex-source": "node scripts/check/verify-codex-source.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@winwincode/browser-core": "0.1.0-alpha.2",
    "@winwincode/browser-ui": "0.1.0-alpha.2",
    "@winwincode/control-plane-client": "0.1.0-alpha.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "@winwincode/network-request": "0.1.0-alpha.2"
  }
}
