{
  "name": "winwincode",
  "version": "0.0.0-dev.0",
  "description": "WinWinCode host for the default DSH chat surface and StrongFlow advanced mode",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "winwincode": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@winwincode/contracts": "workspace:*",
    "@winwincode/dsh-profile": "workspace:*",
    "@winwincode/native": "workspace:*",
    "@winwincode/strongflow": "workspace:*"
  }
}
