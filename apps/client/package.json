{
  "name": "@winwincode/client",
  "version": "0.1.0-alpha.1",
  "description": "Deployable browser client for WinWinCode Chat, StrongFlow, settings, approvals, and enterprise administration",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module/index.js",
  "types": "./dist/module/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module/index.d.ts",
      "import": "./dist/module/index.js"
    },
    "./public/*": "./dist/public/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  }
}
