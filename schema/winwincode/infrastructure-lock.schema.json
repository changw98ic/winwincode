{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winwincode.dev/schema/infrastructure-lock.schema.json",
  "title": "WinWinCode Infrastructure Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "consumerRepository",
    "release",
    "manifest",
    "signature",
    "sbom",
    "licenseManifest",
    "persistenceContract",
    "fixtureCargoLock",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "winwincode.infrastructure-lock.v1"
    },
    "consumerRepository": {
      "enum": [
        "winwincode-cloud",
        "winwincode-enterprise"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sourceCommit",
        "sourceTag"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceTag": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manifest": {
      "$ref": "#/$defs/artifact"
    },
    "signature": {
      "allOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "signingKeySha256"
          ],
          "properties": {
            "algorithm": {
              "const": "Ed25519"
            },
            "signingKeySha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "sbom": {
      "$ref": "#/$defs/artifact"
    },
    "licenseManifest": {
      "$ref": "#/$defs/artifact"
    },
    "persistenceContract": {
      "$ref": "#/$defs/artifact"
    },
    "fixtureCargoLock": {
      "$ref": "#/$defs/artifact"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/artifact"
          },
          {
            "type": "object",
            "required": [
              "name",
              "role",
              "version",
              "sourceCommit",
              "bundlePath",
              "format"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^winwincode-"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sourceCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "bundlePath": {
                "type": "string",
                "pattern": "^[^/].+"
              },
              "format": {
                "const": "cargo-workspace-tar-gzip"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "fileName",
        "artifactUri",
        "sha256",
        "bytes"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "artifactUri": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
