{
  "openapi": "3.1.1",
  "info": {
    "title": "WinWinCode Control Plane API",
    "version": "1.0.0",
    "description": "The two canonical routes are command writes and side-effect-free queries. Body actor must match the authenticated principal and be authorized for scope."
  },
  "paths": {
    "/api/v1/commands": {
      "post": {
        "operationId": "submitControlPlaneCommand",
        "description": "Checks authentication, scope, requestId replay identity, and expectedRevision before mutation. Identical retries return the stored original status and body; changed input with the same requestId returns IDEMPOTENCY_CONFLICT.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./control-plane-http.schema.json#/$defs/CommandRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed or identical replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./control-plane-http.schema.json#/$defs/CommandCompletedResponse"
                }
              }
            }
          },
          "202": {
            "description": "Durably accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./control-plane-http.schema.json#/$defs/CommandAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "PERMISSION_DENIED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "IDEMPOTENCY_CONFLICT, REVISION_CONFLICT, or WRONG_STATE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/queries": {
      "post": {
        "operationId": "submitControlPlaneQuery",
        "description": "Side-effect free. List cursors bind scope, query, filters, and snapshot; results order by snapshot, updatedAt, then ID.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./control-plane-http.schema.json#/$defs/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scoped query projection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./control-plane-http.schema.json#/$defs/QueryResultResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, including an invalid or mismatched cursor",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "PERMISSION_DENIED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "SERVICE_UNAVAILABLE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./domain.schema.json#/$defs/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
