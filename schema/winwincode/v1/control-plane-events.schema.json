{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.winwincode.dev/winwincode/v1/control-plane-events.schema.json",
  "title": "WinWinCode Control Plane WebSocket Protocol v1",
  "description": "Server event delivery and transport-only client frames. Product commands are deliberately absent and use the HTTP command contract.",
  "oneOf": [
    {
      "$ref": "#/$defs/ControlPlaneWebSocketClientFrame"
    },
    {
      "$ref": "#/$defs/ControlPlaneWebSocketServerFrame"
    }
  ],
  "$defs": {
    "ControlPlaneWebSocketSubscriptionId": {
      "type": "string",
      "pattern": "^sub_[A-Za-z0-9_-]{16,128}$"
    },
    "ControlPlaneWebSocketEventSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ControlPlaneWebSocketAuthorizationEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ControlPlaneWebSocketEventType": {
      "type": "string",
      "enum": [
        "activity.recorded.v1",
        "approval.changed.v1",
        "chat-interactions.invalidated.v1",
        "attention.changed.v1",
        "delivery.changed.v1",
        "delivery-task.changed.v1",
        "presence.changed.v1",
        "product-session.changed.v1",
        "product-session.message.appended.v1",
        "runtime-projection.invalidated.v1",
        "worker-health.changed.v1",
        "enterprise-organization.invalidated.v1",
        "enterprise-membership.invalidated.v1",
        "enterprise-team.invalidated.v1",
        "enterprise-role.invalidated.v1",
        "enterprise-project.invalidated.v1",
        "enterprise-policy.invalidated.v1",
        "enterprise-fleet.invalidated.v1",
        "enterprise-usage.invalidated.v1",
        "enterprise-audit.invalidated.v1",
        "enterprise-integration.invalidated.v1"
      ]
    },
    "ControlPlaneWebSocketAcknowledgedCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "stream",
        "sequence",
        "eventId"
      ],
      "properties": {
        "scope": {
          "$ref": "./domain.schema.json#/$defs/Scope"
        },
        "stream": {
          "$ref": "./domain.schema.json#/$defs/EventReadStream"
        },
        "sequence": {
          "$ref": "#/$defs/ControlPlaneWebSocketEventSequence"
        },
        "eventId": {
          "$ref": "./domain.schema.json#/$defs/ControlPlaneEventId"
        }
      }
    },
    "ControlPlaneWebSocketSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "stream",
        "eventTypes"
      ],
      "properties": {
        "scope": {
          "$ref": "./domain.schema.json#/$defs/Scope"
        },
        "stream": {
          "$ref": "./domain.schema.json#/$defs/EventReadStream"
        },
        "eventTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ControlPlaneWebSocketEventType"
          }
        }
      }
    },
    "ControlPlaneWebSocketTransportLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUnackedEvents",
        "hardUnackedEvents",
        "ackDeadlineMillis",
        "backpressureCloseCode"
      ],
      "properties": {
        "maxUnackedEvents": {
          "const": 256
        },
        "hardUnackedEvents": {
          "const": 1024
        },
        "ackDeadlineMillis": {
          "const": 30000
        },
        "backpressureCloseCode": {
          "const": 4408
        }
      }
    },
    "ControlPlaneWebSocketControlPlaneSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "component",
        "actor"
      ],
      "properties": {
        "kind": {
          "const": "control-plane"
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor": {
          "$ref": "./domain.schema.json#/$defs/Actor"
        }
      }
    },
    "ControlPlaneWebSocketExecutionWorkerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workerId",
        "workerSessionId",
        "leaseId",
        "codexThreadId"
      ],
      "properties": {
        "kind": {
          "const": "execution-worker"
        },
        "workerId": {
          "$ref": "./domain.schema.json#/$defs/WorkerId"
        },
        "workerSessionId": {
          "$ref": "./domain.schema.json#/$defs/WorkerSessionId"
        },
        "leaseId": {
          "$ref": "./domain.schema.json#/$defs/LeaseId"
        },
        "codexThreadId": {
          "$ref": "./domain.schema.json#/$defs/CodexThreadId"
        }
      }
    },
    "ControlPlaneWebSocketSessionExecutionWorkerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workerId",
        "workerSessionId",
        "leaseId",
        "codexThreadId",
        "sessionIdentity"
      ],
      "properties": {
        "kind": {
          "const": "execution-worker"
        },
        "workerId": {
          "$ref": "./domain.schema.json#/$defs/WorkerId"
        },
        "workerSessionId": {
          "$ref": "./domain.schema.json#/$defs/WorkerSessionId"
        },
        "leaseId": {
          "$ref": "./domain.schema.json#/$defs/LeaseId"
        },
        "codexThreadId": {
          "$ref": "./domain.schema.json#/$defs/CodexThreadId"
        },
        "sessionIdentity": {
          "$ref": "./domain.schema.json#/$defs/SessionIdentity"
        }
      },
      "description": "Execution-worker source for a session-scoped event. The block must exactly join the event payload."
    },
    "ControlPlaneWebSocketEventSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/ControlPlaneWebSocketControlPlaneSource"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketExecutionWorkerSource"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketSessionExecutionWorkerSource"
        }
      ]
    },
    "ControlPlaneWebSocketProductSessionChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "productSessionId",
        "revision",
        "status"
      ],
      "properties": {
        "type": {
          "const": "product-session.changed.v1"
        },
        "productSessionId": {
          "$ref": "./domain.schema.json#/$defs/ProductSessionId"
        },
        "revision": {
          "$ref": "./domain.schema.json#/$defs/Revision"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "waiting-input",
            "waiting-approval",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "ControlPlaneWebSocketProductSessionMessageAppendedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "productSessionId",
        "message"
      ],
      "properties": {
        "type": {
          "const": "product-session.message.appended.v1"
        },
        "productSessionId": {
          "$ref": "./domain.schema.json#/$defs/ProductSessionId"
        },
        "message": {
          "$ref": "./domain.schema.json#/$defs/ChatMessageProjection"
        }
      },
      "description": "Secret-safe Chat projection only; excludes raw provider, tool, credential, and Codex payloads."
    },
    "ControlPlaneWebSocketApprovalChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "approvalId",
        "productSessionId",
        "state",
        "subject",
        "requestedBy",
        "decidedBy"
      ],
      "properties": {
        "type": {
          "const": "approval.changed.v1"
        },
        "approvalId": {
          "$ref": "./domain.schema.json#/$defs/ApprovalId"
        },
        "productSessionId": {
          "$ref": "./domain.schema.json#/$defs/ProductSessionId"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "denied",
            "expired",
            "cancelled"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "requestedBy": {
          "$ref": "./domain.schema.json#/$defs/Actor"
        },
        "decidedBy": {
          "oneOf": [
            {
              "$ref": "./domain.schema.json#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "ControlPlaneWebSocketAttentionChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "attentionItemId",
        "deliveryId",
        "revision",
        "status",
        "category",
        "summary",
        "assignedTo"
      ],
      "properties": {
        "type": {
          "const": "attention.changed.v1"
        },
        "attentionItemId": {
          "$ref": "./domain.schema.json#/$defs/AttentionItemId"
        },
        "deliveryId": {
          "$ref": "./domain.schema.json#/$defs/DeliveryId"
        },
        "stageRunId": {
          "$ref": "./domain.schema.json#/$defs/StageRunId"
        },
        "revision": {
          "$ref": "./domain.schema.json#/$defs/Revision"
        },
        "status": {
          "type": "string",
          "enum": [
            "blocking",
            "resolved",
            "obsolete"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "credential",
            "execution-approval",
            "user-input",
            "provider",
            "verification",
            "business"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "assignedTo": {
          "oneOf": [
            {
              "$ref": "./domain.schema.json#/$defs/ActorId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ControlPlaneWebSocketDeliveryChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "deliveryId",
        "revision",
        "changeKind"
      ],
      "properties": {
        "type": {
          "const": "delivery.changed.v1"
        },
        "deliveryId": {
          "$ref": "./domain.schema.json#/$defs/DeliveryId"
        },
        "revision": {
          "$ref": "./domain.schema.json#/$defs/Revision"
        },
        "changeKind": {
          "type": "string",
          "enum": [
            "created",
            "advanced",
            "reworked",
            "cancelled",
            "published"
          ]
        }
      }
    },
    "ControlPlaneWebSocketDeliveryTaskChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "deliveryId",
        "deliveryTaskId",
        "revision",
        "changeKind"
      ],
      "properties": {
        "type": {
          "const": "delivery-task.changed.v1"
        },
        "deliveryId": {
          "$ref": "./domain.schema.json#/$defs/DeliveryId"
        },
        "deliveryTaskId": {
          "$ref": "./domain.schema.json#/$defs/DeliveryTaskId"
        },
        "revision": {
          "$ref": "./domain.schema.json#/$defs/Revision"
        },
        "changeKind": {
          "type": "string",
          "enum": [
            "created",
            "assigned",
            "blocked",
            "started",
            "completed",
            "cancelled"
          ]
        }
      }
    },
    "ControlPlaneWebSocketPresenceChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "userId",
        "state",
        "observedAt"
      ],
      "properties": {
        "type": {
          "const": "presence.changed.v1"
        },
        "userId": {
          "$ref": "./domain.schema.json#/$defs/UserId"
        },
        "productSessionId": {
          "$ref": "./domain.schema.json#/$defs/ProductSessionId"
        },
        "state": {
          "type": "string",
          "enum": [
            "online",
            "away",
            "offline"
          ]
        },
        "observedAt": {
          "$ref": "./domain.schema.json#/$defs/Instant"
        }
      }
    },
    "ControlPlaneWebSocketWorkerHealthChangedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "workerId",
        "status",
        "observedAt",
        "activeLeaseCount",
        "availableCapacity"
      ],
      "properties": {
        "type": {
          "const": "worker-health.changed.v1"
        },
        "workerId": {
          "$ref": "./domain.schema.json#/$defs/WorkerId"
        },
        "status": {
          "type": "string",
          "enum": [
            "registering",
            "healthy",
            "degraded",
            "draining",
            "offline"
          ]
        },
        "observedAt": {
          "$ref": "./domain.schema.json#/$defs/Instant"
        },
        "activeLeaseCount": {
          "type": "integer",
          "minimum": 0
        },
        "availableCapacity": {
          "type": "integer",
          "minimum": 0
        },
        "capabilityLabels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "ControlPlaneWebSocketActivityRecordedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actor",
        "category",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "activity.recorded.v1"
        },
        "actor": {
          "$ref": "./domain.schema.json#/$defs/Actor"
        },
        "deliveryId": {
          "$ref": "./domain.schema.json#/$defs/DeliveryId"
        },
        "productSessionId": {
          "$ref": "./domain.schema.json#/$defs/ProductSessionId"
        },
        "category": {
          "type": "string",
          "enum": [
            "product",
            "runtime",
            "approval",
            "publication",
            "collaboration",
            "security"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "ControlPlaneWebSocketEventPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/ControlPlaneWebSocketProductSessionChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketProductSessionMessageAppendedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketRuntimeProjectionInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketApprovalChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketChatInteractionsInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketAttentionChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketDeliveryChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketDeliveryTaskChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketPresenceChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketWorkerHealthChangedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketActivityRecordedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseOrganizationInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseMembershipInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseTeamInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseRoleInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseProjectInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterprisePolicyInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseFleetInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseUsageInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseAuditInvalidatedEvent"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketEnterpriseIntegrationInvalidatedEvent"
        }
      ]
    },
    "ControlPlaneWebSocketSubscribeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "subscription",
        "startAt"
      ],
      "properties": {
        "type": {
          "const": "transport.subscribe.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "subscription": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscription"
        },
        "startAt": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscribeStartAt"
        }
      }
    },
    "ControlPlaneWebSocketResumeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "subscription",
        "after"
      ],
      "properties": {
        "type": {
          "const": "transport.resume.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "subscription": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscription"
        },
        "after": {
          "$ref": "#/$defs/ControlPlaneWebSocketAcknowledgedCursor"
        }
      }
    },
    "ControlPlaneWebSocketAckFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "cursor"
      ],
      "properties": {
        "type": {
          "const": "transport.ack.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "cursor": {
          "$ref": "#/$defs/ControlPlaneWebSocketAcknowledgedCursor"
        }
      }
    },
    "ControlPlaneWebSocketPongFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "nonce"
      ],
      "properties": {
        "type": {
          "const": "transport.pong.v1"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    },
    "ControlPlaneWebSocketClientFrame": {
      "oneOf": [
        {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscribeFrame"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketResumeFrame"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketAckFrame"
        },
        {
          "$ref": "#/$defs/ControlPlaneWebSocketPongFrame"
        }
      ]
    },
    "ControlPlaneWebSocketEventFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "eventId",
        "scope",
        "stream",
        "sequence",
        "occurredAt",
        "source",
        "authorizationEpoch",
        "event"
      ],
      "properties": {
        "type": {
          "const": "event.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "eventId": {
          "$ref": "./domain.schema.json#/$defs/ControlPlaneEventId"
        },
        "scope": {
          "$ref": "./domain.schema.json#/$defs/Scope"
        },
        "stream": {
          "$ref": "./domain.schema.json#/$defs/EventReadStream"
        },
        "sequence": {
          "$ref": "#/$defs/ControlPlaneWebSocketEventSequence"
        },
        "occurredAt": {
          "$ref": "./domain.schema.json#/$defs/Instant"
        },
        "source": {
          "$ref": "#/$defs/ControlPlaneWebSocketEventSource"
        },
        "authorizationEpoch": {
          "$ref": "#/$defs/ControlPlaneWebSocketAuthorizationEpoch"
        },
        "event": {
          "$ref": "#/$defs/ControlPlaneWebSocketEventPayload"
        }
      }
    },
    "ControlPlaneWebSocketSubscriptionAcceptedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "cursor",
        "authorizationEpoch",
        "limits"
      ],
      "properties": {
        "type": {
          "const": "transport.subscription-accepted.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "cursor": {
          "$ref": "./domain.schema.json#/$defs/EventReadCursor"
        },
        "authorizationEpoch": {
          "$ref": "#/$defs/ControlPlaneWebSocketAuthorizationEpoch"
        },
        "limits": {
          "$ref": "#/$defs/ControlPlaneWebSocketTransportLimits"
        }
      }
    },
    "ControlPlaneWebSocketResumeAcceptedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "after",
        "replayThrough",
        "authorizationEpoch"
      ],
      "properties": {
        "type": {
          "const": "transport.resume-accepted.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "after": {
          "$ref": "#/$defs/ControlPlaneWebSocketAcknowledgedCursor"
        },
        "replayThrough": {
          "$ref": "./domain.schema.json#/$defs/EventReadCursor"
        },
        "authorizationEpoch": {
          "$ref": "#/$defs/ControlPlaneWebSocketAuthorizationEpoch"
        }
      }
    },
    "ControlPlaneWebSocketBackpressureFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "pendingEventCount",
        "ackRequiredThrough",
        "disconnectAt",
        "closeCode"
      ],
      "properties": {
        "type": {
          "const": "transport.backpressure.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "pendingEventCount": {
          "type": "integer",
          "minimum": 256
        },
        "ackRequiredThrough": {
          "$ref": "#/$defs/ControlPlaneWebSocketAcknowledgedCursor"
        },
        "disconnectAt": {
          "$ref": "./domain.schema.json#/$defs/Instant"
        },
        "closeCode": {
          "const": 4408
        }
      }
    },
    "ControlPlaneWebSocketAuthorizationRevokedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "authorizationEpoch",
        "closeCode"
      ],
      "properties": {
        "type": {
          "const": "transport.authorization-revoked.v1"
        },
        "subscriptionId": {
          "$ref": "#/$defs/ControlPlaneWebSocketSubscriptionId"
        },
        "authorizationEpoch": {
          "$ref": "#/$defs/ControlPlaneWebSocketAuthorizationEpoch"
        },
        "closeCode": {
          "const": 4403
        }
      }
    },
    "ControlPlaneWebSocketResetRequiredFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "subscriptionId",
        "reason",
