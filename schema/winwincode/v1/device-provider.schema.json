{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.winwincode.dev/winwincode/v1/device-provider.schema.json",
  "title": "Device-owned Provider configuration and encrypted control",
  "description": "API keys are encrypted by WebCrypto for the selected Device. Only Device writes configuration and acknowledges completion.",
  "x-license": "Apache-2.0",
  "$defs": {
    "DeviceProviderProtocol": {
      "type": "string",
      "enum": [
        "anthropic_messages",
        "openai_chat_completions",
        "canonical"
      ]
    },
    "DeviceProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "protocol": {
          "$ref": "#/$defs/DeviceProviderProtocol"
        },
        "modelIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "providerId",
        "displayName",
        "endpoint",
        "protocol",
        "modelIds",
        "enabled"
      ]
    },
    "DeviceProviderProjection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config": {
          "$ref": "#/$defs/DeviceProviderConfig"
        },
        "credentialConfigured": {
          "type": "boolean"
        },
        "openCode": {
          "$ref": "#/$defs/DeviceProviderOpenCodeConnection"
        }
      },
      "required": [
        "config",
        "credentialConfigured"
      ]
    },
    "DeviceConfigurationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "publicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "ciphertext": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "clientNodeId",
        "requestId",
        "expectedRevision",
        "publicKey",
        "nonce",
        "ciphertext"
      ]
    },
    "DeviceProviderOutcome": {
      "type": "string",
      "enum": [
        "saved",
        "deleted",
        "tested",
        "invalid_request",
        "revision_conflict",
        "provider_unavailable",
        "interrupted"
      ]
    },
    "DeviceProviderReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "outcome": {
          "$ref": "#/$defs/DeviceProviderOutcome"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "outcome",
        "revision"
      ]
    },
    "DeviceProviderSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "encryptionPublicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "providers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DeviceProviderProjection"
          }
        },
        "openCodeAccounts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DeviceProviderOpenCodeAccount"
          }
        },
        "openCodeLogins": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DeviceProviderOpenCodeLogin"
          }
        },
        "defaultProviderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "clientNodeId",
        "revision",
        "encryptionPublicKey",
        "providers"
      ]
    },
    "DeviceProviderReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/DeviceProviderSnapshot"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceProviderReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "snapshot",
        "receipt"
      ]
    },
    "DeviceProviderView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "$ref": "./domain.schema.json#/$defs/SchemaVersion"
        },
        "online": {
          "type": "boolean"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceProviderSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceProviderReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "online",
        "snapshot",
        "receipt"
      ]
    },
    "DeviceExtensionOutcome": {
      "type": "string",
      "enum": [
        "saved",
        "deleted",
        "tested",
        "invalid_request",
        "revision_conflict",
        "connection_failed",
        "interrupted"
      ]
    },
    "DeviceExtensionSkill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "enabled": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "source",
        "enabled",
        "digest",
        "fileCount"
      ]
    },
    "DeviceExtensionMcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "transport": {
          "$ref": "#/$defs/DeviceExtensionMcpTransport"
        },
        "toolNames": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "connectionStatus": {
          "$ref": "#/$defs/DeviceExtensionMcpConnectionStatus"
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71
        }
      },
      "required": [
        "id",
        "enabled",
        "transport",
        "toolNames",
        "connectionStatus",
        "digest"
      ]
    },
    "DeviceExtensionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "outcome": {
          "$ref": "#/$defs/DeviceExtensionOutcome"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "outcome",
        "revision"
      ]
    },
    "DeviceExtensionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "encryptionPublicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "skills": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DeviceExtensionSkill"
          }
        },
        "mcpServers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DeviceExtensionMcp"
          }
        }
      },
      "required": [
        "clientNodeId",
        "revision",
        "encryptionPublicKey",
        "skills",
        "mcpServers"
      ]
    },
    "DeviceExtensionReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/DeviceExtensionSnapshot"
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeviceExtensionReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "snapshot",
        "receipt"
      ]
    },
    "DeviceExtensionView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "winwincode/v1"
        },
        "online": {
          "type": "boolean"
        },
        "snapshot": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeviceExtensionSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeviceExtensionReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "online",
        "snapshot",
        "receipt"
      ]
    },
    "DeviceExtensionMcpConnectionStatus": {
      "type": "string",
      "enum": [
        "untested",
        "ready",
        "failed"
      ]
    },
    "DeviceExtensionMcpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "streamable_http"
      ]
    },
    "DeviceProviderOpenCodeAccountState": {
      "type": "string",
      "enum": [
        "authorized",
        "refresh_in_flight",
        "reauthorization_required",
        "logged_out"
      ]
    },
    "DeviceProviderOpenCodeOrganization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "DeviceProviderOpenCodeUsageWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "resetsAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "status",
        "percent",
        "resetsAt"
      ]
    },
    "DeviceProviderOpenCodeUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rolling": {
          "$ref": "#/$defs/DeviceProviderOpenCodeUsageWindow"
        },
        "weekly": {
          "$ref": "#/$defs/DeviceProviderOpenCodeUsageWindow"
        },
        "monthly": {
          "$ref": "#/$defs/DeviceProviderOpenCodeUsageWindow"
        },
        "updatedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "rolling",
        "weekly",
        "monthly",
        "updatedAtMs",
        "organizationId"
      ]
    },
    "DeviceProviderOpenCodeAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountRef": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeAccountId"
        },
        "issuer": {
          "const": "https://opencode.ai/console"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "state": {
          "$ref": "#/$defs/DeviceProviderOpenCodeAccountState"
        },
        "credentialVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "usage": {
          "$ref": "#/$defs/DeviceProviderOpenCodeUsage"
        }
      },
      "required": [
        "accountRef",
        "issuer",
        "subject",
        "email",
        "state",
        "credentialVersion"
      ]
    },
    "DeviceProviderOpenCodeConnection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountRef": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeAccountId"
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "organizationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "accountRef",
        "organizationId",
        "organizationName"
      ]
    },
    "DeviceProviderOpenCodeLoginState": {
      "type": "string",
      "enum": [
        "pending",
        "authorized",
        "denied",
        "expired",
        "cancelled",
        "failed",
        "completed"
      ]
    },
    "DeviceProviderOpenCodeLogin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loginId": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeLoginId"
        },
        "state": {
          "$ref": "#/$defs/DeviceProviderOpenCodeLoginState"
        },
        "verificationUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "userCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pollAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accountRef": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeAccountId"
        },
        "organizations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DeviceProviderOpenCodeOrganization"
          }
        }
      },
      "required": [
        "loginId",
        "state",
        "expiresAtMs",
        "pollAfterMs",
        "organizations"
      ]
    },
    "DeviceProviderOpenCodeSessionBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "productSessionId": {
          "$ref": "./domain.schema.json#/$defs/ProductSessionId"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "accountRef": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeAccountId"
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "productSessionId",
        "providerId",
        "accountRef",
        "organizationId",
        "conversationId"
      ]
    },
    "DeviceProviderOpenCodeOperation": {
      "type": "string",
      "enum": [
        "begin_opencode_login",
        "poll_opencode_login",
        "cancel_opencode_login",
        "connect_opencode",
        "logout_opencode",
        "opencode_usage",
        "set_default_provider"
      ]
    },
    "DeviceProviderOpenCodeCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Optional Go model selector for connect_opencode; fixes the official protocol for the new connection."
        },
        "operation": {
          "$ref": "#/$defs/DeviceProviderOpenCodeOperation"
        },
        "loginId": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeLoginId"
        },
        "accountRef": {
          "$ref": "./domain.schema.json#/$defs/OpenCodeAccountId"
        },
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "operation"
      ]
    }
  },
  "x-winwincode-http": {
    "GET /api/v1/clients/{clientId}/providers": {
      "response": "DeviceProviderView"
    },
    "POST /api/v1/clients/{clientId}/providers": {
      "request": "DeviceConfigurationEnvelope",
      "responseStatus": 202,
      "completion": "Device receipt only"
    },
    "GET /api/v1/clients/{clientId}/providers/receipts/{requestId}": {
      "response": "DeviceProviderView"
    }
  }
}
