{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.winwincode.dev/winwincode/v1/domain.schema.json",
  "title": "WinWinCode v1 domain contracts",
  "description": "Canonical external value objects and projections shared by the Rust Control Plane, Rust Execution Worker, and TypeScript presentation layer.",
  "$defs": {
    "OrganizationId": {
      "type": "string",
      "pattern": "^org_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WorkspaceId": {
      "type": "string",
      "pattern": "^wsp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RepositoryId": {
      "type": "string",
      "pattern": "^rep_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "DeliveryId": {
      "type": "string",
      "pattern": "^dlv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "DeliveryTaskId": {
      "type": "string",
      "pattern": "^dtk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "StageRunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ProductSessionId": {
      "type": "string",
      "pattern": "^psn_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ChatMessageId": {
      "type": "string",
      "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ExecutionJobId": {
      "type": "string",
      "pattern": "^job_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Identity of one scheduler-owned execution job."
    },
    "InputRequestId": {
      "type": "string",
      "pattern": "^inp_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Identity of one interactive input request."
    },
    "PublicationId": {
      "type": "string",
      "pattern": "^pub_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WorkerSessionId": {
      "type": "string",
      "pattern": "^wsn_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CodexThreadId": {
      "type": "string",
      "pattern": "^cdx_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CredentialReferenceId": {
      "type": "string",
      "pattern": "^crd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WorkerId": {
      "type": "string",
      "pattern": "^wrk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "LeaseId": {
      "type": "string",
      "pattern": "^lse_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ApprovalId": {
      "type": "string",
      "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "AttentionItemId": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^evd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RequestId": {
      "type": "string",
      "pattern": "^req_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "UserId": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ServiceAccountId": {
      "type": "string",
      "pattern": "^svc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SystemActorId": {
      "type": "string",
      "pattern": "^sys_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SchemaVersion": {
      "type": "string",
      "const": "winwincode/v1"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "InteractiveInputMode": {
      "type": "string",
      "enum": [
        "confirmation",
        "single_choice",
        "text"
      ]
    },
    "InteractiveInputValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "value"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/InteractiveInputMode"
        },
        "value": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "description": "Bound user response value; never an ExecutionPort message or command payload."
    },
    "ChatMessageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "productSessionId",
        "sequence",
        "role",
        "state",
        "content",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ChatMessageId"
        },
        "productSessionId": {
          "$ref": "#/$defs/ProductSessionId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "streaming",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        },
        "createdAt": {
          "$ref": "#/$defs/Instant"
        },
        "updatedAt": {
          "$ref": "#/$defs/Instant"
        }
      },
      "description": "Secret-safe product message projection. It excludes provider requests, provider responses, tool payloads, credentials, and Codex internals."
    },
    "RuntimeProjectionKind": {
      "type": "string",
      "enum": [
        "plan",
        "agent-graph",
        "activity",
        "command",
        "test",
        "recovery",
        "failure",
        "diff",
        "usage",
        "evidence",
        "input-request",
        "execution-approval"
      ]
    },
    "RuntimeProjectionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productSessionId",
        "workerSessionId",
        "codexThreadId",
        "leaseId",
        "projectionSequence",
        "projectionKind",
        "summary",
        "occurredAt"
      ],
      "properties": {
        "productSessionId": {
          "$ref": "#/$defs/ProductSessionId"
        },
        "workerSessionId": {
          "$ref": "#/$defs/WorkerSessionId"
        },
        "codexThreadId": {
          "$ref": "#/$defs/CodexThreadId"
        },
        "leaseId": {
          "$ref": "#/$defs/LeaseId"
        },
        "deliveryId": {
          "$ref": "#/$defs/DeliveryId"
        },
        "stageRunId": {
          "$ref": "#/$defs/StageRunId"
        },
        "projectionSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "projectionKind": {
          "$ref": "#/$defs/RuntimeProjectionKind"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "occurredAt": {
          "$ref": "#/$defs/Instant"
        }
      },
      "dependentRequired": {
        "deliveryId": [
          "stageRunId"
        ],
        "stageRunId": [
          "deliveryId"
        ]
      }
    },
    "RuntimeProjectionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revision",
        "productSessionId",
        "deliveryId",
        "stageRunId",
        "lastProjectionSequence",
        "items",
        "rebuiltAt"
      ],
      "properties": {
        "kind": {
          "const": "runtime_projection"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "productSessionId": {
          "$ref": "#/$defs/ProductSessionId"
        },
        "deliveryId": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeliveryId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stageRunId": {
          "oneOf": [
            {
              "$ref": "#/$defs/StageRunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastProjectionSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeProjectionItem"
          },
          "maxItems": 10000
        },
        "rebuiltAt": {
          "$ref": "#/$defs/Instant"
        }
      },
      "description": "Complete bounded projection used after restart or WebSocket reset.",
      "oneOf": [
        {
          "properties": {
            "deliveryId": {
              "type": "null"
            },
            "stageRunId": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "deliveryId": {
              "$ref": "#/$defs/DeliveryId"
            },
            "stageRunId": {
              "$ref": "#/$defs/StageRunId"
            }
          }
        }
      ]
    },
    "ActorId": {
      "oneOf": [
        {
          "$ref": "#/$defs/UserId"
        },
        {
          "$ref": "#/$defs/ServiceAccountId"
        },
        {
          "$ref": "#/$defs/SystemActorId"
        }
      ]
    },
    "UserActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "user"
        },
        "id": {
          "$ref": "#/$defs/UserId"
        }
      }
    },
    "ServiceAccountActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "service_account"
        },
        "id": {
          "$ref": "#/$defs/ServiceAccountId"
        }
      }
    },
    "SystemActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "system"
        },
        "id": {
          "$ref": "#/$defs/SystemActorId"
        }
      }
    },
    "Actor": {
      "oneOf": [
        {
          "$ref": "#/$defs/UserActor"
        },
        {
          "$ref": "#/$defs/ServiceAccountActor"
        },
        {
          "$ref": "#/$defs/SystemActor"
        }
      ]
    },
    "OrganizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "organizationId"
      ],
      "properties": {
        "kind": {
          "const": "organization"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        }
      }
    },
    "WorkspaceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "organizationId",
        "workspaceId"
      ],
      "properties": {
        "kind": {
          "const": "workspace"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      }
    },
    "ProjectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "organizationId",
        "workspaceId",
        "projectId"
      ],
      "properties": {
        "kind": {
          "const": "project"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        }
      }
    },
    "RepositoryScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "organizationId",
        "workspaceId",
        "projectId",
        "repositoryId"
      ],
      "properties": {
        "kind": {
          "const": "repository"
        },
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "repositoryId": {
          "$ref": "#/$defs/RepositoryId"
        }
      }
    },
    "Scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/OrganizationScope"
        },
        {
          "$ref": "#/$defs/WorkspaceScope"
        },
        {
          "$ref": "#/$defs/ProjectScope"
        },
        {
          "$ref": "#/$defs/RepositoryScope"
        }
      ]
    },
    "LocalDefaultScope": {
      "allOf": [
        {
          "$ref": "#/$defs/RepositoryScope"
        },
        {
          "properties": {
            "kind": {
              "const": "repository"
            },
            "organizationId": {
              "const": "org_00000000000000000000000000"
            },
            "workspaceId": {
              "const": "wsp_00000000000000000000000000"
            },
            "projectId": {
              "const": "prj_00000000000000000000000000"
            },
            "repositoryId": {
              "const": "rep_00000000000000000000000000"
            }
          }
        }
      ]
    },
    "CommandName": {
      "type": "string",
      "enum": [
        "session.create",
        "chat.submit",
        "input.respond",
        "session.cancel",
        "session.close",
        "delivery.create",
        "delivery.update_spec",
        "delivery.approve_task_breakdown",
        "delivery.advance",
        "delivery.resolve_attention",
        "delivery.submit_verdict",
        "settings.update",
        "credential.reference.create",
        "credential.reference.delete",
        "approval.decide",
        "worker.drain",
        "worker.enable",
        "publication.publish",
        "publication.cancel"
      ]
    },
    "CommandEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "actor",
        "scope",
        "requestId",
        "expectedRevision",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "command": {
          "$ref": "#/$defs/CommandName"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "DeliveryStatus": {
      "type": "string",
      "enum": [
        "draft",
        "clarifying",
        "ready",
        "planning",
        "plan-review",
        "executing",
        "verifying",
        "reworking",
        "needs-attention",
        "ready-to-deliver",
        "delivered"
      ]
    },
    "DeliveryTaskStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "blocked",
        "verifying",
        "completed",
        "failed"
      ]
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "DeliveryOwnershipProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizationId",
        "workspaceId",
        "projectId",
        "repositoryId"
      ],
      "properties": {
        "organizationId": {
          "$ref": "#/$defs/OrganizationId"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "repositoryId": {
          "$ref": "#/$defs/RepositoryId"
        }
      }
    },
    "DeliveryTaskCountsProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "pending",
        "active",
        "blocked",
        "verifying",
        "completed",
        "failed"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/Count"
        },
        "pending": {
          "$ref": "#/$defs/Count"
        },
        "active": {
          "$ref": "#/$defs/Count"
        },
        "blocked": {
          "$ref": "#/$defs/Count"
        },
        "verifying": {
          "$ref": "#/$defs/Count"
        },
        "completed": {
          "$ref": "#/$defs/Count"
        },
        "failed": {
          "$ref": "#/$defs/Count"
        }
      }
    },
    "DeliveryProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "deliveryId",
        "revision",
        "ownership",
        "title",
        "status",
        "taskCounts",
        "activeStageRunId",
        "openAttentionCount",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "deliveryId": {
          "$ref": "#/$defs/DeliveryId"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "ownership": {
          "$ref": "#/$defs/DeliveryOwnershipProjection"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "$ref": "#/$defs/DeliveryStatus"
        },
        "taskCounts": {
          "$ref": "#/$defs/DeliveryTaskCountsProjection"
        },
        "activeStageRunId": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageRunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "openAttentionCount": {
          "$ref": "#/$defs/Count"
        },
        "updatedAt": {
          "$ref": "#/$defs/Instant"
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "AUTHENTICATION_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "WRONG_STATE",
        "RATE_LIMITED",
        "SERVICE_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "TerminalErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "AUTHENTICATION_REQUIRED",
        "PERMISSION_DENIED",
        "RESOURCE_NOT_FOUND",
        "IDEMPOTENCY_CONFLICT",
        "REVISION_CONFLICT",
        "WRONG_STATE",
        "INTERNAL_ERROR"
      ]
    },
    "RetryableErrorCode": {
      "type": "string",
      "enum": [
        "RATE_LIMITED",
        "SERVICE_UNAVAILABLE"
      ]
    },
    "ErrorDetailValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ErrorDetailValue"
          }
        },
        {
          "$ref": "#/$defs/ErrorDetails"
        }
      ],
      "description": "A recursive JSON value whose object branches apply the public error redaction rules."
    },
    "ErrorDetails": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ErrorDetailValue"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "accessToken",
            "agentGraph",
            "apiKey",
            "codexPlan",
            "database",
            "databaseRow",
            "deliveryPatch",
            "deliveryVerdict",
            "password",
            "providerCredential",
            "rawProviderRequest",
            "rawProviderResponse",
            "secret",
            "secretMaterial",
            "socketPath",
            "sql",
            "table",
            "toolPayload",
            "turn",
            "vaultLocator"
          ]
        }
      },
      "description": "Machine-readable error facts. Authority-sensitive property names are rejected recursively at the public boundary."
    },
    "TerminalError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/TerminalErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "const": false
        },
        "details": {
          "$ref": "#/$defs/ErrorDetails"
        }
      }
    },
    "RetryableError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/RetryableErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "const": true
        },
        "details": {
          "$ref": "#/$defs/ErrorDetails"
        }
      }
    },
    "Error": {
      "oneOf": [
        {
          "$ref": "#/$defs/TerminalError"
        },
        {
          "$ref": "#/$defs/RetryableError"
        }
      ]
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "error"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "requestId": {
          "$ref": "#/$defs/RequestId"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      }
    }
  }
}
