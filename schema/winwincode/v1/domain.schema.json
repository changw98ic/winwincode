        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "const": false
        },
        "details": {
          "$ref": "#/$defs/ErrorDetails"
        }
      }
    },
    "RetryableError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/RetryableErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "const": true
        },
        "details": {
          "$ref": "#/$defs/ErrorDetails"
        }
      }
    },
    "Error": {
      "oneOf": [
        {
          "$ref": "#/$defs/TerminalError"
        },
        {
          "$ref": "#/$defs/RetryableError"
