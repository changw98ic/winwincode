          "$ref": "#/$defs/Error"
        }
      }
    },
    "RuntimePlanItemStatus": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ]
    },
    "RuntimePlanItemProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "status"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "status": {
          "$ref": "#/$defs/RuntimePlanItemStatus"
        }
      }
    },
    "RuntimePlanProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "explanation",
        "items",
        "text",
        "complete",
        "sourceRef"
      ],
      "properties": {
        "itemId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimePlanItemProjection"
          },
          "maxItems": 200
        },
        "text": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "RuntimeAgentStatus": {
      "type": "string",
      "enum": [
        "unknown",
        "waiting",
        "running",
        "completed",
        "interrupted",
        "failed",
        "closed"
      ]
    },
    "RuntimeAgentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "parentThreadId",
        "path",
        "nickname",
        "role",
        "status",
        "sourceRef"
      ],
      "properties": {
        "threadId": {
          "$ref": "#/$defs/CodexThreadId"
        },
        "parentThreadId": {
          "oneOf": [
            {
              "$ref": "#/$defs/CodexThreadId"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "nickname": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/RuntimeAgentStatus"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "RuntimeAgentEdgeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentThreadId",
        "childThreadId"
      ],
      "properties": {
        "parentThreadId": {
          "$ref": "#/$defs/CodexThreadId"
        },
        "childThreadId": {
          "$ref": "#/$defs/CodexThreadId"
        }
      }
    },
    "RuntimeActivityType": {
      "type": "string",
      "enum": [
        "command",
        "test"
      ]
    },
    "RuntimeActivityStatus": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "declined",
        "cancelled",
        "unknown"
      ]
    },
    "RuntimeActivityOutcome": {
      "type": "string",
      "enum": [
        "observed",
        "succeeded",
        "task-failed",
        "timed-out",
        "policy-denied",
        "infrastructure-failed",
        "cancelled"
      ]
    },
    "RuntimeActivityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId",
        "activityType",
        "command",
        "status",
        "outcome",
        "exitCode",
        "sourceRef"
      ],
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        "activityType": {
          "$ref": "#/$defs/RuntimeActivityType"
        },
        "command": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/RuntimeActivityStatus"
        },
        "outcome": {
          "$ref": "#/$defs/RuntimeActivityOutcome"
        },
        "exitCode": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "RuntimeUsageMetricProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,99}$"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "RuntimeUsageProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totals",
        "sourceRef"
      ],
      "properties": {
        "totals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeUsageMetricProjection"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "description": "Usage totals are sorted by metric name before publication."
    },
    "RuntimeRecoveryState": {
      "type": "string",
      "enum": [
        "none",
        "required",
        "in-progress",
        "recovered"
      ]
    },
