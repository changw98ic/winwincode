        "failureCount",
        "recoveryCount",
        "lastFailureSourceRef",
        "latestRecoverySourceRef"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/RuntimeRecoveryState"
        },
        "failureCount": {
          "$ref": "#/$defs/Count"
        },
        "recoveryCount": {
          "$ref": "#/$defs/Count"
        },
        "lastFailureSourceRef": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "latestRecoverySourceRef": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RuntimeDiffSummaryProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changedFileCount",
        "additions",
        "deletions",
        "detailsVisible",
        "sourceRef"
      ],
      "properties": {
        "changedFileCount": {
          "$ref": "#/$defs/Count"
        },
        "additions": {
          "$ref": "#/$defs/Count"
        },
        "deletions": {
          "$ref": "#/$defs/Count"
        },
        "detailsVisible": {
          "const": false
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "description": "Live execution exposes counts and a source reference only; paths, hunks, and unified diff bytes are excluded."
    },
    "RuntimeSessionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionBindingId",
        "stageRunId",
        "deliveryTaskId",
        "productSessionId",
        "workerSessionId",
        "codexThreadId",
        "executionJobId",
        "leaseId",
        "attempt",
        "fencingToken",
        "asOfSequence",
        "plan",
        "agents",
        "agentEdges",
        "activities",
        "usage",
        "recovery",
        "diffSummary"
      ],
      "properties": {
        "sessionBindingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        "stageRunId": {
          "oneOf": [
            {
              "$ref": "#/$defs/StageRunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "deliveryTaskId": {
          "oneOf": [
            {
              "$ref": "#/$defs/DeliveryTaskId"
            },
            {
              "type": "null"
            }
          ]
        },
        "productSessionId": {
          "$ref": "#/$defs/ProductSessionId"
        },
        "workerSessionId": {
          "$ref": "#/$defs/WorkerSessionId"
        },
        "codexThreadId": {
          "$ref": "#/$defs/CodexThreadId"
        },
        "executionJobId": {
          "$ref": "#/$defs/ExecutionJobId"
        },
        "leaseId": {
          "$ref": "#/$defs/LeaseId"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fencingToken": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "asOfSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "plan": {
          "oneOf": [
            {
              "$ref": "#/$defs/RuntimePlanProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeAgentProjection"
          },
          "maxItems": 256
        },
        "agentEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeAgentEdgeProjection"
          },
          "maxItems": 512
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeActivityProjection"
          },
          "maxItems": 100
        },
        "usage": {
          "oneOf": [
            {
              "$ref": "#/$defs/RuntimeUsageProjection"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "$ref": "#/$defs/RuntimeRecoveryProjection"
        },
        "diffSummary": {
          "oneOf": [
            {
              "$ref": "#/$defs/RuntimeDiffSummaryProjection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "One deterministic StrongFlow session projection built only from an exact accepted runtime binding."
    },
    "RuntimeProjectionEventCursor": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProductSessionEventReadCursor"
        },
        {
          "$ref": "#/$defs/DeliveryEventReadCursor"
        }
      ],
      "description": "Exact event baseline for a ProductSession runtime snapshot or Delivery-stage runtime snapshot."
    },
    "ControlPlaneEventId": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{16,128}$",
      "description": "Stable identity of one persisted Control Plane event, independent of transport."
    },
    "EventReadPosition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Last persisted sequence included in a snapshot or event-stream baseline; zero represents an empty stream."
    },
    "ScopeEventReadStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "scope"
        }
      }
    },
    "DeliveryEventReadStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "deliveryId"
      ],
      "properties": {
        "kind": {
          "const": "delivery"
        },
        "deliveryId": {
          "$ref": "#/$defs/DeliveryId"
        }
      }
    },
    "ProductSessionEventReadStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "productSessionId"
      ],
      "properties": {
        "kind": {
          "const": "product-session"
        },
        "productSessionId": {
          "$ref": "#/$defs/ProductSessionId"
        }
      }
    },
    "LeaseEventReadStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workerId",
        "leaseId"
      ],
      "properties": {
        "kind": {
          "const": "lease"
        },
        "workerId": {
          "$ref": "#/$defs/WorkerId"
        },
        "leaseId": {
          "$ref": "#/$defs/LeaseId"
        }
      }
    },
    "EventReadStream": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScopeEventReadStream"
        },
        {
          "$ref": "#/$defs/DeliveryEventReadStream"
        },
        {
          "$ref": "#/$defs/ProductSessionEventReadStream"
        },
        {
          "$ref": "#/$defs/LeaseEventReadStream"
        }
      ],
      "description": "One exact ordered Control Plane event stream shared by snapshot and push transports."
    },
    "ScopeEventReadCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "stream",
        "sequence",
        "eventId"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "stream": {
          "$ref": "#/$defs/ScopeEventReadStream"
        },
        "sequence": {
          "$ref": "#/$defs/EventReadPosition"
        },
        "eventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/ControlPlaneEventId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exact position in one scope-wide event stream. Empty streams use sequence zero with null eventId; positive positions require the persisted event ID.",
      "oneOf": [
        {
          "properties": {
            "sequence": {
              "const": 0
            },
            "eventId": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "eventId": {
              "$ref": "#/$defs/ControlPlaneEventId"
            }
          }
        }
      ]
    },
    "DeliveryEventReadCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "stream",
        "sequence",
        "eventId"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/RepositoryScope"
        },
        "stream": {
          "$ref": "#/$defs/DeliveryEventReadStream"
        },
        "sequence": {
          "$ref": "#/$defs/EventReadPosition"
        },
        "eventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/ControlPlaneEventId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exact position in one repository-scoped Delivery event stream. Empty streams use sequence zero with null eventId; positive positions require the persisted event ID.",
      "oneOf": [
        {
          "properties": {
            "sequence": {
              "const": 0
            },
            "eventId": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "eventId": {
              "$ref": "#/$defs/ControlPlaneEventId"
            }
          }
        }
      ]
    },
    "ProductSessionEventReadCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "stream",
        "sequence",
        "eventId"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/RepositoryScope"
        },
        "stream": {
          "$ref": "#/$defs/ProductSessionEventReadStream"
        },
        "sequence": {
          "$ref": "#/$defs/EventReadPosition"
        },
        "eventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/ControlPlaneEventId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exact position in one repository-scoped ProductSession event stream. Empty streams use sequence zero with null eventId; positive positions require the persisted event ID.",
      "oneOf": [
        {
          "properties": {
            "sequence": {
              "const": 0
            },
            "eventId": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "eventId": {
              "$ref": "#/$defs/ControlPlaneEventId"
            }
          }
        }
      ]
    },
    "LeaseEventReadCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "stream",
        "sequence",
        "eventId"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "stream": {
          "$ref": "#/$defs/LeaseEventReadStream"
        },
        "sequence": {
          "$ref": "#/$defs/EventReadPosition"
        },
        "eventId": {
          "oneOf": [
            {
              "$ref": "#/$defs/ControlPlaneEventId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Exact position in one worker lease event stream. Empty streams use sequence zero with null eventId; positive positions require the persisted event ID.",
      "oneOf": [
        {
          "properties": {
            "sequence": {
              "const": 0
            },
            "eventId": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "eventId": {
              "$ref": "#/$defs/ControlPlaneEventId"
            }
          }
        }
      ]
    },
    "EventReadCursor": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScopeEventReadCursor"
        },
        {
          "$ref": "#/$defs/DeliveryEventReadCursor"
        },
        {
          "$ref": "#/$defs/ProductSessionEventReadCursor"
        },
        {
          "$ref": "#/$defs/LeaseEventReadCursor"
        }
      ],
      "description": "Transport-neutral exact stream position carried from a complete snapshot into event subscription."
    },
    "ApiTokenId": {
      "type": "string",
      "pattern": "^tok_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ExternalIdentityId": {
      "type": "string",
      "pattern": "^xid_[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
