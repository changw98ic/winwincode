{
  "version": "winwincode.network-request-policy.v1",
  "maxAttempts": 4,
  "initialDelayMs": 5000,
  "maxConnectionDelayMs": 60000,
  "maxImmediateWaitMs": 300000,
  "authorityCheckMs": 100,
  "jitterMs": 255,
  "transientKinds": [
    "connection_unavailable",
    "transport_interrupted",
    "timeout",
    "rate_limited",
    "server_transient",
    "stream_incomplete",
    "protocol_invalid",
    "empty_response"
  ]
}
