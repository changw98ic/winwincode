{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "noEmit": true,
    "rootDir": ".",
    "sourceMap": false
  },
  "include": [
    "apps/client/src/**/*.ts",
    "packages/browser-ui/src/**/*.ts",
    "packages/control-plane-client/src/**/*.ts",
    "packages/browser-core/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/strongflow/src/**/*.ts",
    "tests/fixtures/browser-control-type-gate.ts",
    "tests/fixtures/browser-control-assignability-gate.ts"
  ]
}
