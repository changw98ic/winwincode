  "observableBehaviors": [
    {
      "id": "session-delivery-and-runtime-recovery",
      "kind": "persistence",
      "currentFacts": [
        "DSH Session persistence, RuntimeSessionLedger, DeliveryStore, and native lifecycle records survive process restart",
        "a resumed stage retains distinct DSH Session and Codex session identities",
        "request replay does not repeat a settled Delivery mutation"
      ],
      "targetFacts": [
        "Control Plane persists ProductSession, Delivery, SessionBinding, runtime projections, and requestId results",
        "Worker persists only the bounded WorkerSession and workspace recovery state it owns",
        "restart rebuilds projections without replaying code mutation"
      ],
      "behaviorBaselineIds": [
        "stage-cancel",
        "restart-recovery",
        "approval-block",
        "native-close"
      ]
    },
    {
      "id": "ordered-runtime-and-approval-events",
      "kind": "event",
      "currentFacts": [
        "Codex runtime events remain monotonic inside one exact DSH and Codex session binding",
        "model stream, command approval, business Attention, cancellation, and terminal outcome stay distinct",
        "events from unrelated sessions do not enter a Delivery projection"
      ],
      "targetFacts": [
        "Worker emits ordered ExecutionPort envelopes bound to Job, Lease, WorkerSession, and CodexThread",
        "Control Plane validates fencing, persists the event, projects business state, and then broadcasts WebSocket updates",
        "WebSocket projection does not become a business command path"
      ],
      "behaviorBaselineIds": [
        "chat-turn-success",
        "stage-cancel",
        "restart-recovery",
        "approval-block"
      ]
    },
    {
      "id": "stable-redacted-public-errors",
      "kind": "error",
      "currentFacts": [
        "provider failures keep stable category and retry facts while diagnostics and credentials are redacted",
        "cancellation remains AbortError rather than a provider or task failure",
        "closing an already-ended native session releases resources without crashing the host"
      ],
      "targetFacts": [
        "Control Plane exposes stable generated error codes and bounded public details",
        "Worker reports cancellation, policy denial, task failure, infrastructure failure, and close as separate outcomes",
        "unknown provider text and credential material never enter events, audit records, or API responses"
      ],
      "behaviorBaselineIds": [
        "model-failure",
        "stage-cancel",
        "native-close"
      ]
    }
  ],
