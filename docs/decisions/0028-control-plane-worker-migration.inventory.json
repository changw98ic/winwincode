  "observableBehaviors": [
    {
      "id": "runtime-and-session-recovery",
      "kind": "persistence",
      "currentFacts": [
        "ProductSession, StageRun, WorkerSession, CodexThread and lease facts are durable across restart",
        "replaying one request returns its original receipt"
      ],
      "targetFacts": [
        "Control Plane rebuilds projections from canonical state and receipts",
        "a new attempt receives a new execution identity while old attempt facts remain immutable"
      ],
      "behaviorBaselineIds": [
        "recovery",
        "exact-replay"
      ]
    },
    {
      "id": "ordered-runtime-and-terminal-facts",
      "kind": "event",
      "currentFacts": [
        "ExecutionPort frames carry job, lease, worker and thread identities",
        "terminal outcome and cancellation are distinct typed facts"
      ],
      "targetFacts": [
        "Server persists validated frames before publishing projections",
        "fencing rejects stale runtime and outcome writes"
      ],
      "behaviorBaselineIds": [
        "success",
        "cancel",
        "failure"
      ]
    },
    {
      "id": "secret-safe-public-errors",
      "kind": "error",
      "currentFacts": [
        "provider failures preserve stable categories and retry facts",
