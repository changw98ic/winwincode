      ],
      "requiredTests": [
        "github_adapter_applies_and_then_reconciles_the_complete_publication_set",
        "github_adapter_classifies_permission_and_rate_limit_without_remote_diagnostics",
        "duplicate_pull_request_response_reconciles_the_exact_remote_identity",
        "comment_rejection_preserves_the_pull_request_identity_and_skips_status",
        "rate_limited_publication_resumes_from_durable_requests_without_persisting_the_secret"
      ]
