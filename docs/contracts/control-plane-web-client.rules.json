    "pageDirectFetchAllowed": false,
    "pageDirectWebSocketAllowed": false,
    "pageTransportDtoAllowed": false,
    "workerAddressAllowed": false,
    "webSocketBusinessCommandAllowed": false
  },
  "verification": {
    "documentation": "docs/contracts/control-plane-web-client.md",
