      "/api/v1/commands",
      "/api/v1/queries",
      "/api/v1/events",
      "transport.subscribe.v1",
      "transport.resume.v1",
      "transport.ack.v1",
      "transport.pong.v1"
    ],
    "forbiddenTransportPropertySets": [
