  "activation": {
    "trigger": "apps/client/src/generated/control-plane-client.ts",
    "behaviorProof": "tests/generated-control-plane-client.test.mjs",
    "proofUsesExports": [
      "createControlPlaneHttpClient",
      "createControlPlaneWebSocketClient",
      "createStrongFlowProjectionSubscription",
      "createProductSessionRuntimeProjectionSubscription"
    ]
  },
  "http": {
    "authSessionPath": "/api/v1/auth/session",
    "commandPath": "/api/v1/commands",
    "queryPath": "/api/v1/queries",
    "commandIdentity": [
      "requestId",
      "expectedRevision"
    ],
    "retryRule": "reuse-identical-command-envelope-and-request-id",
    "queryCursor": "opaque-and-bound-to-scope-query-filter-snapshot",
    "requestValidation": "full-canonical-schema-and-operation-discriminator-before-network",
    "responseValidation": "full-canonical-schema-and-request-discriminator",
    "webSocketCommandAllowed": false
  },
  "websocket": {
    "eventsPath": "/api/v1/events",
    "clientFrameType": "ControlPlaneWebSocketClientFrame",
    "serverFrameType": "ControlPlaneWebSocketServerFrame",
    "allowedClientFrames": [
      "transport.subscribe.v1",
      "transport.resume.v1",
      "transport.ack.v1",
      "transport.pong.v1"
    ],
    "cursorAdvance": "after-event-handler-succeeds-before-cumulative-ack",
    "duplicateRule": "deduplicate-by-exact-event-id-sequence-and-payload",
    "sequenceRule": "accepted-baseline-plus-one-without-gaps-or-rollbacks",
    "authorizationRule": "event-epoch-at-or-after-accepted-baseline-without-client-rollback",
    "lifecycleRule": "subscription-generation-cancels-stale-cursor-and-ack-publication",
    "closeRules": {
      "ordinaryDisconnect": "resume-after-last-acknowledged-cursor",
      "close4408": "resume-after-last-acknowledged-cursor",
      "close4409": "reload-complete-snapshot-by-original-subscription-stream",
      "close4403": "clear-subscription-and-do-not-auto-retry"
    },
    "resetFrameReloadQueries": false,
    "deliveryResetQueries": [
      "delivery.get",
      "runtime.projection.get"
    ],
    "productSessionResetQueries": [
      "runtime.projection.get"
    ]
  },
  "errorBoundary": {
    "source": "ErrorEnvelope",
    "publicFields": [
      "code",
      "message",
      "requestId",
      "retryable",
      "details"
    ],
    "forbiddenFields": [
      "authorization",
      "body",
      "credential",
      "headers",
      "providerRequest",
      "providerResponse",
      "secret",
      "stack",
      "token",
      "url"
    ],
    "invalidResponse": "bounded-generic-error-without-raw-response-copy",
    "detailSanitization": "recursive-case-and-separator-insensitive-key-rejection"
  },
  "boundary": {
    "webRoot": "apps/client",
    "facade": "apps/client/src/control-plane-client.ts",
    "generatedNetworkOwner": "apps/client/src/generated",
    "forbiddenImportFragments": [
      "crates/winwincode-server",
      "crates/winwincode-control-plane",
      "crates/winwincode-worker",
      "crates/winwincode-execution-port",
