{
  "schemaVersion": "winwincode.control-plane-web-client-gate.v2",
  "issueId": "winwincode-9c4.16.6.6.5",
  "status": "implemented-enforced",
  "coverage": {
    "mode": "git-file-inventory+rg+ast-grep-fallback",
    "symbolGraphComplete": false,
    "reason": "The contract records repository-relative files and structural checks; it does not substitute for the source dependency graph."
  },
  "architecture": {
    "clientRoot": "apps/client",
    "serverRoot": "crates/winwincode-server",
    "controlPlaneRoot": "crates/winwincode-control-plane",
    "workerRoot": "crates/winwincode-worker",
    "localRoot": "crates/winwincode-local",
    "helperRoot": "crates/helper",
    "generatedNetworkOwner": "apps/client/src/generated",
    "serverEntrypoint": "crates/winwincode-server/src/main.rs",
    "clientEntrypoint": "apps/client/src/index.ts"
  },
  "inventory": {
    "client": {
      "currentFiles": [
        "apps/client/src/application.ts",
        "apps/client/src/chat-page.ts",
        "apps/client/src/strongflow-page.ts",
        "apps/client/src/settings-page.ts",
        "apps/client/src/enterprise-application.ts",
        "apps/client/src/local-decisions-page.ts",
        "apps/client/src/local-operations-page.ts",
        "apps/client/src/control-plane-client.ts",
        "apps/client/src/generated/contracts.ts",
        "apps/client/src/generated/control-plane-client.ts"
      ],
      "networkImplementation": true,
      "pageImplementation": true,
      "transport": "generated-http-and-websocket-client",
      "stateRule": "pages keep view state only; Control Plane owns durable business state"
    },
    "server": {
      "paths": [
        "crates/winwincode-server/src/main.rs",
        "crates/winwincode-server/src/server.rs",
        "crates/winwincode-server/src/dispatcher.rs"
      ],
      "transport": "Rust HTTP-and-WebSocket-boundary",
      "stateRule": "boundary validates generated requests and delegates business writes"
    },
    "controlPlane": {
      "paths": [
        "crates/winwincode-control-plane/src/lib.rs",
        "crates/winwincode-control-plane/src/session_binding_transaction.rs",
        "crates/winwincode-control-plane/src/delivery_execution.rs"
      ],
      "authority": "ProductSession, Delivery, policy, credentials reference, scheduler and receipts"
    },
    "worker": {
      "paths": [
        "crates/winwincode-worker/src/lib.rs",
        "crates/winwincode-worker/src/workspace_runtime.rs"
      ],
      "authority": "Job, Lease, fencing, workspace and runtime execution"
    },
    "local": {
      "paths": [
        "crates/winwincode-local/src/lib.rs"
      ],
      "composition": "assembles the Rust Server/Control Plane and Worker for one local process"
    },
    "helper": {
      "paths": [
        "crates/helper/src/main.rs"
      ],
      "composition": "authenticated kernel helper executable with no product state"
    }
  },
  "generation": {
    "generator": "scripts/generate-contracts.mjs",
    "canonicalInputs": [
      "schema/winwincode/v1/domain.schema.json",
      "schema/winwincode/v1/control-plane-http.schema.json",
      "schema/winwincode/v1/control-plane-events.schema.json"
    ],
    "contractTypes": "apps/client/src/generated/contracts.ts",
    "client": "apps/client/src/generated/control-plane-client.ts",
    "generatedMarker": "Generated by scripts/generate-contracts.mjs. Do not edit.",
    "allowedImports": [
      "./contracts.js"
    ],
    "requiredClientExports": [
      {
        "name": "ControlPlaneClientError",
        "kind": "class"
      },
      {
        "name": "ControlPlaneHttpClient",
        "kind": "interface"
      },
      {
        "name": "ControlPlaneWebSocketClient",
        "kind": "interface"
      },
      {
        "name": "StrongFlowProjectionSubscription",
        "kind": "interface"
      },
      {
        "name": "ProductSessionRuntimeProjectionSubscription",
        "kind": "interface"
      },
      {
        "name": "createControlPlaneHttpClient",
        "kind": "function"
      },
      {
        "name": "createControlPlaneWebSocketClient",
        "kind": "function"
      },
      {
        "name": "createStrongFlowProjectionSubscription",
        "kind": "function"
      },
      {
        "name": "createProductSessionRuntimeProjectionSubscription",
        "kind": "function"
      }
    ],
    "requiredClientMembers": [
      {
        "export": "ControlPlaneClientError",
        "members": [
          "code",
          "requestId",
          "retryable",
          "details"
