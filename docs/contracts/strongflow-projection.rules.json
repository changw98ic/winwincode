{
  "schemaVersion": "winwincode.strongflow-projection-rules.v1",
  "issueId": "winwincode-9c4.16.2.5",
  "purpose": "Freeze the StrongFlow read model, source ownership, exact runtime binding, replay, redaction, and generated-Web boundaries before the Rust projection becomes canonical.",
  "rustTarget": {
    "deliveryCrate": "crates/winwincode-delivery",
    "controlPlaneCrate": "crates/winwincode-control-plane",
    "controlPlaneTrigger": "crates/winwincode-control-plane/src/strongflow_projection.rs",
    "scanRule": "A missing concrete implementation file means that projection slice has not started. Once delivery.rs, solution.rs, runtime.rs, redaction.rs, or the Control Plane trigger exists, only rules assigned to that concrete trigger require their named module and Rust test.",
    "deliveryTriggers": [
      "crates/winwincode-delivery/src/projection/delivery.rs",
      "crates/winwincode-delivery/src/projection/solution.rs",
      "crates/winwincode-delivery/src/projection/runtime.rs",
      "crates/winwincode-delivery/src/projection/redaction.rs"
    ]
  },
