  "runtimeBinding": {
    "requiredIdentity": [
      "deliveryId",
      "stageRunId",
      "productSessionId",
      "workerSessionId",
      "codexThreadId",
      "executionJobId",
      "leaseId",
      "attempt",
      "fencingToken"
    ],
    "unboundEventPolicy": "reject-before-projection",
    "ambiguousEventPolicy": "reject-before-projection",
    "staleLeasePolicy": "reject-before-persist-and-projection",
    "sequencePolicy": "accept-only-the-next-contiguous-sequence; acknowledge an exact duplicate; request replay for a gap; reject changed or older content"
  },
  "dataPolicy": {
    "liveDiff": {
      "allowedFields": [
        "changedFileCount",
        "additions",
        "deletions",
        "detailsVisible",
        "sourceRef"
      ],
      "detailsVisible": false,
      "forbiddenFields": [
        "changedFiles",
        "filePath",
        "hunk",
        "hunkContent",
        "unifiedDiff"
      ]
    },
    "frozenDiff": {
      "visibility": "separate-authorized-frozen-candidate-detail-projection",
      "preconditions": [
        "stage-run-is-settled",
        "candidate-is-frozen",
        "candidate-matches-current-spec-revision",
        "candidate-diff-digest-is-verified",
        "producer-session-binding-is-exact",
        "viewer-is-authorized-for-delivery-review"
      ]
    },
    "forbiddenAtEveryPublicSeam": [
      "apiKey",
      "authorization",
      "credential",
      "providerRequest",
      "providerResponse",
      "rawRuntimeLog",
      "stderr",
      "stdout",
      "toolPayload"
    ]
  },
  "rules": [
    {
      "id": "authority.projection_is_read_only",
      "statement": "Projection code reads canonical Delivery, Publication, and accepted runtime facts; it does not mutate them, schedule Codex, create Agent state, or write a second event log.",
      "refs": [
        "docs/decisions/0023-canonical-delivery-ownership.md",
        "docs/decisions/0028-control-plane-worker-migration.md",
        "packages/strongflow/src/delivery-runtime-projection.ts"
      ],
      "baseline": {
        "tests": [
          {
            "path": "tests/delivery-runtime-projection.test.mjs",
            "name": "live and reopened ledgers rebuild the same read-only Delivery runtime view"
          }
        ]
      },
      "rust": {
        "trigger": "crates/winwincode-delivery/src/projection/delivery.rs",
        "path": "crates/winwincode-delivery/src/projection/delivery.rs",
        "testName": "projection_is_read_only_over_authoritative_sources"
      }
    },
    {
      "id": "runtime.exact_session_binding",
      "statement": "A runtime event is projected only after all Delivery, StageRun, ProductSession, WorkerSession, CodexThread, Job, Lease, attempt, and fencing identities resolve to one current SessionBinding.",
      "refs": [
        "docs/decisions/0028-control-plane-worker-migration.md",
        "packages/strongflow/src/delivery-runtime-projection.ts",
        "schema/winwincode/v1/execution-port.schema.json"
      ],
      "baseline": {
        "tests": [
          {
            "path": "tests/delivery-runtime-projection.test.mjs",
            "name": "Delivery runtime projection requires the complete DSH and Codex session binding"
          }
        ]
      },
      "rust": {
        "trigger": "crates/winwincode-delivery/src/projection/runtime.rs",
        "path": "crates/winwincode-delivery/src/projection/runtime.rs",
        "testName": "runtime_event_requires_one_exact_session_binding"
      }
    },
    {
      "id": "runtime.reject_unbound_or_ambiguous_event",
      "statement": "An event matching no SessionBinding or more than one SessionBinding fails before any projection item is emitted.",
      "refs": [
        "packages/strongflow/src/delivery-runtime-projection.ts",
        "tests/delivery-runtime-projection.test.mjs"
      ],
      "baseline": {
        "tests": [
          {
            "path": "tests/delivery-runtime-projection.test.mjs",
            "name": "Delivery runtime projection rejects events outside its SessionBindings"
          }
        ]
      },
      "rust": {
        "trigger": "crates/winwincode-delivery/src/projection/runtime.rs",
        "path": "crates/winwincode-delivery/src/projection/runtime.rs",
        "testName": "runtime_projection_rejects_unbound_or_ambiguous_event"
      }
    },
    {
      "id": "runtime.reject_stale_lease_attempt",
      "statement": "Expired leases, old attempts, old Worker instances, and stale fencing tokens are rejected before runtime persistence and therefore never enter StrongFlow.",
      "refs": [
        "schema/winwincode/v1/execution-port.schema.json",
        "docs/contracts/execution-port-v1.md"
      ],
      "baseline": {
        "tests": []
      },
      "rust": {
        "trigger": "crates/winwincode-delivery/src/projection/runtime.rs",
        "path": "crates/winwincode-delivery/src/projection/runtime.rs",
        "testName": "runtime_projection_rejects_stale_lease_attempt"
      }
    },
    {
      "id": "runtime.contiguous_session_sequence",
      "statement": "Each bound runtime session advances by one sequence at a time; exact duplicates are harmless, gaps request replay, and changed or old events fail.",
      "refs": [
        "packages/strongflow/src/delivery-runtime-projection.ts",
        "schema/winwincode/v1/execution-port.schema.json"
      ],
      "baseline": {
        "tests": [
          {
            "path": "tests/runtime-projection.test.mjs",
            "name": "missing, conflicting, and old kernel events fail with stable codes"
          }
        ]
