  "contractFindings": [
    {
      "id": "http.delivery_detail_projection_missing",
      "status": "open",
      "current": "domain.schema.json DeliveryProjection is a list-sized summary with title, status, task counts, active StageRun, and open Attention count. delivery.get returns that same summary.",
      "target": "delivery.get returns a discriminated StrongFlow detail projection containing requirements, approved solution, stages, tasks, Attention, Evidence, Verdict, and a publication summary without exposing the mutable domain entity.",
      "action": "Add a new detailed API DTO in a later canonical schema revision; keep DeliveryPage on the compact summary DTO and regenerate Rust and TypeScript outputs together.",
      "refs": [
        "schema/winwincode/v1/domain.schema.json",
        "schema/winwincode/v1/control-plane-http.schema.json"
      ]
    },
    {
      "id": "http.solution_projection_missing",
      "status": "open",
      "current": "The phase-one public schema has no approved solution or plan-review projection. The TypeScript product stores the frozen review protocol inside canonical Attention context and resolution text.",
      "target": "A safe typed solution projection validates the current review-set digest and exposes structured solution, diagrams, risks, unresolved items, and human decision without returning raw protocol JSON.",
      "action": "Define a solution DTO when phase 2.5 updates the canonical schema and implement its parser against current canonical Attention data.",
      "refs": [
        "packages/contracts/src/strongflow-plan-review.ts",
        "schema/winwincode/v1/domain.schema.json"
      ]
    },
    {
      "id": "http.structured_runtime_projection_missing",
      "status": "open",
      "current": "RuntimeProjectionItem exposes projectionKind, summary, sourceRef, sequence, and session identities, but no typed plan, Agent graph, activity, usage, recovery, Diff summary, or Evidence payload.",
      "target": "runtime.projection.get returns a bounded discriminated per-kind detail union that can rebuild all visible StrongFlow runtime sections without raw logs or raw live Diff.",
      "action": "Add typed runtime detail branches in a later canonical schema revision and retain the existing summary as the common safe envelope.",
      "refs": [
        "schema/winwincode/v1/domain.schema.json",
        "packages/contracts/src/strongflow-runtime-execution.ts"
      ]
    },
    {
      "id": "websocket.structured_runtime_delta_missing",
      "status": "open",
      "current": "runtime-projection.appended.v1 sends only projectionKind, summary, sourceRef, sequence, and session identities.",
      "target": "The event either carries the same typed safe runtime detail branch as the snapshot or is explicitly an invalidation that makes the client reload the snapshot; it never makes the browser infer a second runtime model from prose.",
      "action": "Choose and document one path in the next schema revision, then keep reset/replay behavior consistent with runtime.projection.get.",
      "refs": [
        "schema/winwincode/v1/control-plane-events.schema.json",
        "schema/winwincode/v1/domain.schema.json"
      ]
    },
    {
      "id": "http.publication_join_missing",
      "status": "open",
      "current": "PublicationProjection is available only through publication.get/list, while DeliveryProjection has no current publication reference or status.",
      "target": "StrongFlow can display one current publication status that is checked against the current Delivery, target, candidate, Verdict, and approval under one defined snapshot rule.",
      "action": "Add a bounded publication summary to the StrongFlow detail DTO or define an explicit consistent multi-query join; do not copy provider response bodies into Delivery.",
      "refs": [
        "schema/winwincode/v1/control-plane-http.schema.json",
        "packages/strongflow/src/github-publication-journal.ts"
      ]
    },
    {
      "id": "execution_port.codex_binding_not_guaranteed",
      "status": "open",
      "current": "runtime.event carries WorkerSession and Lease/Job/attempt/fencing identity but no top-level CodexThreadId. job.outcome can carry CodexThreadId only as an optional finished outcome field.",
      "target": "Before projecting a runtime event, the Control Plane can prove one current WorkerSession-to-CodexThread SessionBinding for the active Job and Lease; it never guesses a thread identity from summary or opaque payload bytes.",
      "action": "During Session/Worker migration, persist an authoritative binding before events become visible or revise ExecutionPort to carry a guaranteed binding message; buffer or reject events until the binding exists.",
      "refs": [
        "schema/winwincode/v1/execution-port.schema.json",
        "docs/decisions/0028-control-plane-worker-migration.md"
      ]
    },
    {
      "id": "codegen.generated_runtime_client_missing",
      "status": "open",
      "current": "apps/web/src/generated/contracts.ts contains generated DTO types and enums but no generated HTTP request or WebSocket subscription implementation.",
      "target": "Web imports one generated client for HTTP queries/commands and WebSocket subscription/reset handling; page code owns rendering and local interaction state only.",
      "action": "Extend canonical code generation when the Web app is implemented; keep the generated directory as the sole network owner declared by ADR-0028.",
      "refs": [
        "apps/web/src/generated/contracts.ts",
        "scripts/generate-contracts.mjs",
        "docs/decisions/0028-control-plane-worker-target-graph.json"
      ]
    }
