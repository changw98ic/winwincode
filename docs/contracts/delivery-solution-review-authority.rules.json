  "rules": [
    {
      "id": "authority.current_exact_review_set",
      "statement": "The resolver accepts exactly one current review context whose Delivery, Spec revision, planning StageRun and binding, human review StageRun, Attention item, and digest all match the canonical Delivery.",
      "sources": [
        "packages/strongflow/src/plan-review.ts",
        "crates/winwincode-delivery/src/application/attention.rs"
      ]
    },
    {
      "id": "authority.pending_and_settled_are_one_type",
      "statement": "ValidatedSolutionReviewSet represents pending, approved, changes_requested, and rejected states so the same safe review content remains visible before and after a decision.",
      "sources": [
        "packages/contracts/src/strongflow-plan-review.ts",
        "crates/winwincode-delivery/src/projection/solution.rs"
      ]
    },
    {
      "id": "authority.production_resolver_only",
      "statement": "Only the Delivery-crate resolver rebuilds the opaque fact from current canonical Attention data; HTTP, callers, deserialization, and public raw constructors cannot supply it.",
      "sources": [
        "docs/decisions/0023-canonical-delivery-ownership.md",
        "crates/winwincode-delivery/src/projection/solution.rs"
      ]
    },
    {
      "id": "decision.exact_settlement",
      "statement": "Pending has no decision, reviewer, or review time; every settled action binds the authenticated resolvedBy reviewer and exact resolvedAt and review StageRun finish time.",
      "sources": [
        "packages/strongflow/src/plan-review.ts",
        "crates/winwincode-delivery/src/application/attention.rs"
      ]
    },
    {
      "id": "digest.covers_ordered_task_proposals",
      "statement": "reviewSetSha256 covers the strict v1 context, safe solution content, and every DeliveryTaskProposal in approved product order, so changing or reordering a task changes the digest.",
      "sources": [
        "packages/strongflow/src/plan-review.ts",
        "crates/winwincode-delivery/src/application/task.rs"
      ]
    },
    {
      "id": "encoding.one_strict_v1",
      "statement": "Context and decision use one exact-key v1 family with deterministic encoding; unknown keys and the old TypeScript v2 protocols are rejected without aliases or dual reads.",
      "sources": [
        "packages/contracts/src/strongflow-plan-review.ts",
        "docs/decisions/0028-control-plane-worker-migration.md"
      ]
    },
    {
      "id": "legacy.human_review_binding_is_rejected",
      "statement": "The old TypeScript reviewSessionBinding is source evidence only and never enters the v1 context, validated fact, public projection, or human review lifecycle.",
      "sources": [
        "packages/strongflow/src/plan-review.ts",
        "crates/winwincode-delivery/src/application/stage.rs"
      ]
    },
    {
      "id": "projection.pending_review_is_visible",
      "statement": "An open current plan review projects its bounded solution and non-empty ordered task proposals with pending status and null decision, reviewerId, and reviewedAt.",
      "sources": [
        "crates/winwincode-delivery/src/application/stage.rs",
        "crates/winwincode-delivery/src/projection/solution.rs"
      ]
    },
    {
      "id": "projection.safe_fields_only",
      "statement": "The solutionReview projection exposes typed bounded data, status, decision, reviewer, and time but never raw Attention context or resolution, credentials, tool data, or logs.",
      "sources": [
        "packages/contracts/src/strongflow-plan-review.ts",
        "crates/winwincode-delivery/src/projection/solution.rs"
      ]
    },
    {
      "id": "promotion.approved_only",
      "statement": "Only approved authorizes atomic promotion of the exact ordered task proposals and execution; pending, changes_requested, and rejected never authorize either action.",
      "sources": [
        "crates/winwincode-delivery/src/application/task.rs",
        "crates/winwincode-delivery/src/application/stage.rs"
      ]
    }
  ]
