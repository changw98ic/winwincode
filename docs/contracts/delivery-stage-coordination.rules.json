        "activeStage": "reworking",
        "nextStage": "verifying",
        "nextDeliveryStatus": "verifying"
      },
      {
        "deliveryStatus": "ready-to-deliver",
        "activeStage": null,
        "nextStage": "delivery-review",
        "nextDeliveryStatus": "needs-attention"
      }
