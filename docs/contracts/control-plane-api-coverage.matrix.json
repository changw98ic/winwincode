        "approval.decide"
      ],
      "httpQueries": [
        "approval.list",
        "approval.get"
      ],
      "websocketEvents": [
        "approval.changed.v1",
        "activity.recorded.v1"
      ],
      "executionPortMessages": [
        "approval.request",
        "approval.decision"
      ]
    },
    {
