  "auditFindings": [
    {
      "id": "default-chat-execution-scope",
      "status": "closed-by-contract",
      "finding": "The original ExecutionScope required DeliveryId and StageRunId, so default Chat could not dispatch without inventing a hidden Delivery.",
      "resolution": "ExecutionScope is a strict union of product-session and delivery-stage scopes."
    },
    {
      "id": "projection-recovery-read-path",
      "status": "closed-by-contract",
      "finding": "session.get and delivery.get metadata could not rebuild Chat or StrongFlow runtime views after restart or WebSocket reset.",
      "resolution": "session.messages.list and runtime.projection.get provide secret-safe rebuild inputs."
    },
    {
      "id": "persisted-chat-message-event",
      "status": "closed-by-contract",
      "finding": "The WebSocket union had no public Chat message event and runtime summaries were not a replacement for user and assistant message projection.",
      "resolution": "product-session.message.appended.v1 carries only canonical ChatMessageProjection."
    },
    {
      "id": "interactive-input-command",
      "status": "closed-by-contract",
      "finding": "ExecutionPort input.response had no browser business command with enough identity to validate the active request.",
      "resolution": "input.respond binds actor, revision, ProductSession, WorkerSession, Job, and input request before Control Plane emits input.response."
    }
  ]
