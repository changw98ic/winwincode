      "httpCommands": [],
      "httpQueries": [
        "delivery.get",
        "runtime.projection.get"
      ],
      "websocketEvents": [
        "runtime-projection.appended.v1",
        "activity.recorded.v1"
      ],
      "executionPortMessages": [
        "artifact.open",
        "artifact.chunk",
        "artifact.ack"
