      "currentObservableOperations": [
        "create and update a DeliverySpec with revision and request identity",
        "approve the task breakdown and advance the one legal next stage",
        "resolve business Attention with bounded remediation",
        "request server-computed verdicts for one candidate stale-check digest and rebuild the Delivery view"
