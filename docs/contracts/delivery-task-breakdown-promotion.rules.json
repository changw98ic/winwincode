      ]
    },
    "forbiddenProductionInputs": [
      "Vec<DeliveryTask>",
      "DeliveryTaskInput",
      "DeliveryTaskProposalProjection",
      "raw-solution-review-json",
      "raw-attention-context",
      "raw-attention-resolution"
    ],
    "forbiddenOldPaths": [
      "application::task::approve_task_breakdown",
      "DeliveryApproveTaskBreakdownPayload.tasks",
      "generic-AppendDelivery-task-breakdown",
      "generic-ControlPlane-commit-delivery-command"
    ],
    "removedPathEvidence": {
      "legacyTaskPath": "crates/winwincode-delivery/src/application/task.rs"
    }
  },
  "rules": [
    {
      "id": "authority.planner_proposals_are_review_digest_input",
      "statement": "Planner task proposals exist only inside the typed solution review context, keep their product order, and are covered by reviewSetSha256 before a human decision.",
      "sources": [
        "docs/contracts/delivery-solution-review-authority.md",
        "docs/contracts/delivery-solution-review-authority.rules.json"
      ]
    },
    {
      "id": "authority.approved_seal_is_the_only_promotion_input",
      "statement": "Only the opaque ApprovedTaskPromotion borrowed from the exact current approved ValidatedSolutionReviewSet can authorize promotion.",
      "sources": [
        "docs/contracts/delivery-solution-review-authority.md",
        "docs/contracts/delivery-solution-review-authority.rules.json"
      ]
    },
    {
      "id": "authority.transition_is_the_only_task_constructor",
      "statement": "prepare_task_breakdown_promotion is the only production constructor that turns approved proposals into a sealed Delivery transition and event.",
      "sources": [
        "crates/winwincode-delivery/src/application/task.rs",
        "crates/winwincode-delivery/src/application/mod.rs"
      ]
    },
    {
      "id": "mapping.proposal_fields_and_order_are_exact",
      "statement": "The promoted graph preserves proposal order and copies id, title, goal, acceptanceCriterionIds, and blockedByTaskIds without caller or scheduler rewriting.",
      "sources": [
        "docs/contracts/delivery-solution-review-authority.rules.json",
        "crates/winwincode-delivery/src/domain/task.rs"
      ]
    },
    {
      "id": "mapping.control_plane_derives_owner_and_status",
      "statement": "Every promoted task receives the current Delivery identity, owner null, and pending status; Planner and HTTP cannot set these fields.",
      "sources": [
        "docs/contracts/delivery-solution-review-authority.rules.json",
        "crates/winwincode-delivery/src/domain/task.rs"
      ]
    },
    {
      "id": "graph.invalid_graphs_change_no_fact",
      "statement": "Empty, duplicate, foreign, self-dependent, missing-dependent, or cyclic proposal graphs fail before any durable mutation.",
      "sources": [
        "docs/contracts/delivery-solution-review-authority.rules.json",
        "crates/winwincode-delivery/src/domain/mod.rs"
      ]
    },
    {
      "id": "freshness.current_delivery_spec_review_and_digest_are_required",
      "statement": "Promotion must resolve the current Delivery, Spec, planning run and binding, human review, Attention, authenticated reviewer, and exact reviewSetSha256 again.",
      "sources": [
        "docs/contracts/delivery-solution-review-authority.md",
        "docs/contracts/delivery-stage-coordination.md"
      ]
    },
    {
      "id": "freshness.revision_race_and_second_approval_fail_closed",
      "statement": "A changed expectedRevision, a second approval for the same Spec revision, or a concurrent winner rejects the loser without partial facts.",
      "sources": [
        "crates/winwincode-delivery/src/store.rs",
        "crates/winwincode-storage/src/lib.rs"
      ]
    },
    {
      "id": "http.payload_contains_stale_identity_only",
      "statement": "delivery.approve_task_breakdown accepts only deliveryId and reviewSetSha256 in its payload; tasks and task fields are unknown properties.",
      "sources": [
        "schema/winwincode/v1/control-plane-http.schema.json",
        "docs/contracts/delivery-stage-coordination.md"
      ]
    },
    {
      "id": "store.specialized_command_is_the_only_append",
      "statement": "Only DeliveryCommand::ApproveTaskBreakdown may append TaskBreakdownApproved; generic Append cannot acquire the sealed transition authority.",
      "sources": [
        "crates/winwincode-delivery/src/store.rs",
        "docs/contracts/delivery-stage-coordination.md"
      ]
    },
    {
      "id": "transaction.four_members_commit_or_rollback",
      "statement": "Canonical Delivery state, journal record, scoped command receipt, and the internal task-breakdown plus public Delivery-change outbox rows commit in one storage transaction or all roll back.",
      "sources": [
        "docs/contracts/control-plane-storage-lifecycle.md",
        "crates/winwincode-storage/src/lib.rs"
      ]
    },
    {
      "id": "replay.receipt_first_returns_original_graph",
      "statement": "An identical scoped request checks its receipt before current authority and returns the first committed revision, graph, and event bytes without recomputation.",
      "sources": [
        "crates/winwincode-storage/src/lib.rs",
        "crates/winwincode-control-plane/src/verdict_transaction.rs"
      ]
    },
    {
      "id": "outbox.only_committed_event_is_published",
      "statement": "The publisher reads only the committed internal DeliveryTaskBreakdownApprovedEvent and public delivery.changed.v1 rows; publication failure leaves their exact bytes and projection cursor pending for replay.",
      "sources": [
        "docs/contracts/control-plane-storage-lifecycle.md",
        "crates/winwincode-control-plane/src/lib.rs"
      ]
    },
    {
      "id": "bypass.generic_append_and_commit_are_rejected",
      "statement": "The generic Delivery Append and generic ControlPlane::commit paths reject task-breakdown authority, so no caller can persist a replacement graph.",
      "sources": [
        "crates/winwincode-delivery/src/store.rs",
        "crates/winwincode-control-plane/src/lib.rs"
      ]
    }
  ],
  "closedFindings": [
    {
      "id": "caller-supplied-tasks-http",
      "status": "closed",
      "preflightFinding": "The preflight base schema still accepts payload.tasks; phase 2.5.3 replaces it with reviewSetSha256 and no alias.",
      "closureEvidence": "DeliveryApproveTaskBreakdownPayload now has exactly deliveryId and reviewSetSha256 in canonical schema plus generated Rust and TypeScript.",
      "refs": [
        "schema/winwincode/v1/control-plane-http.schema.json",
        "crates/winwincode-api/src/generated.rs",
        "apps/web/src/generated/contracts.ts"
      ]
    },
    {
      "id": "caller-supplied-tasks-domain",
      "status": "closed",
      "preflightFinding": "The preflight base application::task function accepts Vec<DeliveryTask> from its caller.",
      "closureEvidence": "The old application::task approval function is removed; application::task_breakdown accepts only ApprovedTaskPromotion.",
      "refs": [
        "crates/winwincode-delivery/src/application/task_breakdown.rs"
      ]
    },
    {
      "id": "specialized-store-command-missing",
      "status": "closed",
      "preflightFinding": "The preflight base DeliveryCommand has no ApproveTaskBreakdown variant.",
      "closureEvidence": "DeliveryCommand::ApproveTaskBreakdown is the sole Store mutation and generic Append rejects TaskBreakdownApproved.",
      "refs": [
        "crates/winwincode-delivery/src/store.rs"
      ]
    },
    {
      "id": "specialized-control-plane-transaction-missing",
      "status": "closed",
      "preflightFinding": "The preflight base Control Plane has no task_breakdown_transaction or receipt-first entry.",
      "closureEvidence": "ControlPlane::commit_delivery_task_breakdown performs receipt-first replay and one atomic state/journal/receipt/outbox transaction.",
      "refs": [
        "crates/winwincode-control-plane/src/task_breakdown_transaction.rs"
      ]
    }
  ]
}
