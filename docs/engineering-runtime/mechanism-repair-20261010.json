      "originalMechanism": "每个事件和 ACK 全量重写历史",
      "behavior": "固定头与追加事件共同提交；精确重复及完整证据读取保留",
      "acceptanceGoal": "实际 CP 和 RuntimeReplay 规模回归、缺口、冲突、迁移"
    },
    {
      "issue": "winwincode-community.7.5.29.16.4",
      "originalMechanism": "原 InputResponse 拒绝同一租约的合法续期",
      "behavior": "接受已证明的精确续期，保留原输入截止及调用身份",
      "acceptanceGoal": "原等待者一次消费、ACK 丢失、续租、过期及异主拒绝"
    },
    {
      "issue": "winwincode-community.7.5.29.16.5",
      "originalMechanism": "产品只接受一题",
      "behavior": "合法多题分别投影，完整答案交付原 turn 和 call",
      "acceptanceGoal": "Default 两题、Plan 三题、部分答案、跨进程恢复、大答案读取"
    },
    {
      "issue": "winwincode-community.7.5.29.16.6",
      "originalMechanism": "延期被当作预算耗尽",
      "behavior": "明确保留立即重试、持久延期和停止；新物理请求使用新 decoder",
      "acceptanceGoal": "首次 301 秒 Retry-After、释放请求槽、恢复正文绑定及物理请求账本"
    },
    {
      "issue": "winwincode-community.7.5.29.16.7",
      "originalMechanism": "停派状态发布延迟，迟到终态无法精确收尾",
      "behavior": "即时发布排空和未决；查询原 launch 的精确终态",
      "acceptanceGoal": "原身份不变、原记录保留、迟到终态、证据写入失败和零新调用"
    },
    {
      "issue": "winwincode-community.7.5.29.16.8",
      "originalMechanism": "空待发查询扫描已完成历史",
      "behavior": "用精确索引读取所属待发页和回执",
      "acceptanceGoal": "真实方法 VM 步数、查询计划、损坏拒绝、身份隔离"
    },
    {
      "issue": "winwincode-community.7.5.29.16.9",
      "originalMechanism": "每个长 timer 留下独立睡眠线程",
      "behavior": "单个所属调度器在 clear、close 和 terminate 时及时回收",
      "acceptanceGoal": "实际 V8 host 的线程及回调观察"
    },
    {
      "issue": "winwincode-community.7.5.29.16.10",
      "originalMechanism": "Pending 分支先深拷贝所有待保存值",
      "behavior": "确认完成后才收集交付值",
      "acceptanceGoal": "大 store 和多次小回包的实际分配计数及最终内容"
    },
    {
      "issue": "winwincode-community.7.5.29.16.11",
