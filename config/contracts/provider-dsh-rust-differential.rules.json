  "approvedDifferences": [
    {
      "id": "versioned-catalog-authority",
      "scenarioId": "catalog-routing",
      "dshBehavior": "provider route replacement is atomic and pins prepared calls, while model lists remain advisory and unlisted exact model IDs may still dispatch",
      "rustBehavior": "the scoped versioned catalog rejects unknown or disabled exact model IDs before provider I/O and emits one durable invalidation per accepted update",
      "userVisibleImpact": "none"
    },
    {
      "id": "reference-only-credential-authority",
      "scenarioId": "credential-failure",
      "dshBehavior": "credential-bearing prepared configuration is rejected at the ModelPort boundary",
      "rustBehavior": "the Gateway resolves a scoped credential reference and rejects revoked or leaked material before adapter dispatch",
      "userVisibleImpact": "none"
    },
    {
      "id": "canonical-unknown-provider-error",
      "scenarioId": "typed-errors",
      "dshBehavior": "unclassified pi-ai failures use PI_AI_ERROR",
      "rustBehavior": "unclassified adapter failures use PROVIDER_STREAM_FAILED",
      "userVisibleImpact": "none"
    },
    {
      "id": "typed-worker-cancellation",
      "scenarioId": "cancel-and-disconnect",
      "dshBehavior": "an aborted stream preserves the safe upstream failure code when present",
      "rustBehavior": "an explicit Worker cancellation uses the canonical CANCELLED terminal code",
      "userVisibleImpact": "none"
    },
    {
      "id": "canonical-namespace-identity-validation",
      "scenarioId": "namespaced-parallel-tools",
      "dshBehavior": "invalid, colliding, and overlong names are normalized into bounded provider aliases before round-trip mapping",
      "rustBehavior": "only canonical tool identities are accepted and explicit alias bindings preserve namespace without parsing provider aliases",
      "userVisibleImpact": "none"
    },
    {
      "id": "visible-reasoning-without-forged-provider-signature",
      "scenarioId": "reasoning-and-parallel-tools",
      "dshBehavior": "visible historical reasoning remains a DSH reasoning block before both parallel tool calls",
      "rustBehavior": "the Anthropic adapter retains visible historical reasoning as assistant text before both tool_use blocks because canonical history has no provider-signed thinking block and no signature is forged",
      "userVisibleImpact": "none"
    },
    {
      "id": "provider-auto-tool-choice-shape",
      "scenarioId": "request-translation",
      "dshBehavior": "only auto is accepted and provider auto-selection is represented by the absence of a forced tool choice in generated options",
      "rustBehavior": "the Anthropic adapter sends the equivalent explicit tool_choice object with type auto",
      "userVisibleImpact": "none"
    }
  ],
